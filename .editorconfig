root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,csproj,props,targets}]
indent_size = 2

# C# style. Enforced at build, not by review: TreatWarningsAsErrors in
# Directory.Build.props turns each of these into a failure rather than a note
# somebody scrolls past.
[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_diagnostic.CA1416.severity = error

# A discarded result is the intent (fluent builders, Utf8JsonWriter); `_ =` on each is noise.
dotnet_diagnostic.IDE0058.severity = none
# The estate's methods are block-bodied.
dotnet_diagnostic.IDE0022.severity = none
# The estate's local functions are block-bodied.
dotnet_diagnostic.IDE0061.severity = none

# MAUI compiles Platforms/<system> into the app's own namespace; the folder
# says which system builds the file, not where its type lives.
[**/Platforms/**.cs]
dotnet_diagnostic.IDE0130.severity = none
