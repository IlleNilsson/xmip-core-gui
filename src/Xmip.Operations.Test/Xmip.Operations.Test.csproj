<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desktop configuration editor's tests (ADR-0052 clause 6). The
    Configure page and its editing components are rendered with bUnit over
    the runtime this estate built: edits not saved held on leaving, discarded
    on request, a stale file never overwritten, and every control named for
    what it edits; and the sample cluster this repository ships validates.
    What the page calls — the cluster's file, its save, slices and plan — is
    Xmip.Surface's (ClusterConfiguration, SliceDelivery, RuntimeCommands) and
    proved in Xmip.Surface.Test.

    Xmip.Operations is a MAUI executable for Windows and the phones, which a
    test host cannot reference; its Razor components depend on nothing of
    MAUI, so the test compiles those files where they live. They are linked,
    not copied, and keep the namespace their own @namespace gives them.

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Operations.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Test classes are public for the runner, not for a reader. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
    <Content Include="..\Xmip.Operations\Components\Editing\*.razor"
             Link="Components\Editing\%(Filename)%(Extension)" />
    <Content Include="..\Xmip.Operations\Components\Pages\Configure.razor"
             Link="Components\Pages\Configure.razor" />
    <!-- The desktop's keeper of an operator's key, Windows CNG: it depends on
         nothing of MAUI, so it is proved here on this machine. The phones'
         keepers are proved on their phones. -->
    <Compile Include="..\Xmip.Operations\Platforms\Windows\CngKeeper.cs"
             Link="Platforms\Windows\CngKeeper.cs" />
    <!-- The test cluster's names, read by the one helper every .NET test
         shares (ADR-0056, amendment 2026-10-03). -->
    <Compile Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface.Test\TestCluster.cs"
             Link="TestCluster.cs" />
    <!-- The runtime and a written cluster, shared with the configuration's
         own tests in Xmip.Surface.Test. -->
    <Compile Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface.Test\Estate.cs"
             Link="Estate.cs" />
    <Using Include="Xmip.Surface" />
    <Using Include="Xmip.Surface.Test" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
