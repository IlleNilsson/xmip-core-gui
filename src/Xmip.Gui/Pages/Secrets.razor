@page "/secrets"
@using Xmip.Gui.Surface
@inherits ClusterView
@inject RoleContext Role
@inject ProgramAudit Audited

<PageTitle>Xmip — Secrets</PageTitle>

<RunLine Run="Surface.Run()" Cluster="@Cluster" Source="@Surface.Source"
         IncludeHidden="IncludeHidden" />

@* The secrets a Location presents to the party it connects to (ADR-0019,
   amendment 2026-10-29; ADR-0014, amendment 2026-10-30): a Location names
   one with secret = "<name>", and the node keeps it in its Administration
   Database, sealed. Listed by name, kind, and when and by whom it was set —
   never a value, which no surface reads back out — and set or replaced by
   name, kind and a value typed or read from a file, through
   IOperatorSurface.SetSecret behind the one gate, and audited as
   secret.set with the name and never the value. A secret is a node's, so the
   view stands at one node: the one the surface reaches, or the one the
   address names. The listing and the act are an Operator's and up, as the
   node's own rule has it; an Observer is told so and shown neither. *@
<section class="drill subscriptions secrets">
    <DrillTrail Top="secrets" Location="@AskedLocation" Carried="@Carried"
                At="@(at => ScopeLink.Secrets(at, Carried))" />

    <p class="subs-configured">@Named</p>

    @if (!Role.MayOperate())
    {
        <p class="empty secret-unlisted">@ForOperators</p>
    }
    else
    {
        <ActNotes Refusal="@Refusal" Answer="@Answer" Counted="@Counted" Where="@Where" />

        @if (AskedLocation is null && Nodes.Count > 1)
        {
            <nav class="secret-nodes" aria-label="Nodes">
                @foreach (string node in Nodes)
                {
                    <a class="secret-node" href="@ScopeLink.Secrets(node, Carried)">
                        @ScopeTree.Node(node)
                    </a>
                }
            </nav>
        }

        @if (Refusal.Length == 0)
        {
            <SecretTable Records="Listed" />
        }

        <SecretSet Acted="Set" />
    }
</section>

@code {
    /// <summary>Where a secret is named, and where it is kept.</summary>
    public const string Named =
        "A Location names the secret it presents with secret = \"<name>\"; the node keeps "
        + "it sealed in its Administration Database and never shows its value.";

    /// <summary>What an Observer is told instead of the listing.</summary>
    public const string ForOperators =
        "The secrets are listed and set by an Operator and up.";

    [SupplyParameterFromQuery(Name = "location")] public string? AskedLocation { get; set; }

    private IReadOnlyList<SecretRecord> Listed { get; set; } = [];

    private IReadOnlyList<string> Nodes { get; set; } = [];

    // What the listing was refused, and what the last act said, which stays
    // while the publications tick under it.
    private string Refusal { get; set; } = string.Empty;

    private string Answer { get; set; } = string.Empty;

    // The cluster and node last listed: a tick of the publication asks the
    // node nothing again; a move, or an act, does.
    private string? listedAt;

    // The node the view stands at: the one the address names, or empty, the
    // one node the surface reaches.
    private string Node => AskedLocation ?? string.Empty;

    private string Counted => $"{English.Figure((ulong)Listed.Count)} secret(s)";

    private string Where => Node.Length == 0
        ? "a secret is set through the node this view reaches"
        : $"a secret is set through {Node}";

    protected override void Read()
    {
        string at = $"{Cluster}\n{Node}";

        if (at == listedAt)
        {
            return;
        }

        listedAt = at;
        List();
    }

    private void List()
    {
        Refusal = string.Empty;
        Listed = [];

        if (!Role.MayOperate())
        {
            return;
        }

        Nodes = Surface.NodeScopes();

        try
        {
            Listed = Surface.Secrets(Node);
        }
        catch (InvalidOperationException refused)
        {
            Refusal = Said(refused.Message);
        }
    }

    // The node's words as they came, where they say what they are; else a
    // refusal.
    private static string Said(string words) =>
        words.StartsWith("REFUSED", StringComparison.Ordinal)
            || words.StartsWith("FAILED", StringComparison.Ordinal)
            ? words
            : $"REFUSED: {words}";

    // A set, through the one gate as the proven caller (ADR-0009, amendment
    // 2026-10-06), which refuses one whose role may not act; recorded in this
    // host's audit with what came of it (ADR-0062) as secret.set, with the
    // secret's name and kind — never its value — and said. The value is this
    // call's alone and is kept nowhere.
    private void Set((string Name, string Kind, string Value) asked)
    {
        string who = Role.Who ?? string.Empty;

        SecretOperation done = new GatedOperator(Surface, Role, Audited)
            .SetSecret(Node, asked.Name, asked.Kind, asked.Value, who);
        Audited.Record(
            $"secret.{SecretOperation.Act}",
            done.Applied ? AuditPhase.Execute : AuditPhase.Failure,
            done.Applied ? AuditSeverity.Information : AuditSeverity.Warning,
            done.Result,
            new Dictionary<string, string>
            {
                ["node"] = Node,
                ["secret"] = asked.Name,
                ["kind"] = asked.Kind,
                ["who"] = who,
            });
        Answer = ActSaid.Answer(done.Applied, done.Result);
        List();
    }
}
