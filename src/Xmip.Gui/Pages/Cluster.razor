@page "/"
@using Xmip.Gui.Surface
@inherits ClusterView

<PageTitle>Xmip — Monitor</PageTitle>

<RunLine Run="Surface.Run()" Cluster="@Cluster" Source="@Surface.Source"
         IncludeHidden="IncludeHidden" />

<ScopeFilterBox Id="filter-monitor" Pattern="@Pattern" PatternChanged="Filtered"
                Said="@Filter.Said" />

@* The cluster: how it is, and what it moves. An operator runs the message
   path — Receive, Process, Send — and looks at a node only when a stage is
   not Fine. So the stages are the landing page and the nodes are at the
   bottom. A scope that is Holding says why on the spot: the worst leaf
   beneath it and that leaf's evidence, and the leaf is a link to its place
   in the drill (ADR-0052 clause 2). *@
<section class="cluster @Class(All)">
    <span class="dot"></span>
    <span class="state">@English.Rollup(All)</span>
    <Why Leaf="Index.Worst(Top)" Cluster="@Carried" Linked="true" />
    <span class="detail">@Nodes.Count node(s) · @All.Count thing(s) observed</span>
</section>

@* A card per stage: what that stage counted — the figures taken on it and
   nothing else (IOperatorSurface.Stage) — and what is configured at it, each
   Receive Location, Work Process or Send Location once. Until 2026-09-26 the
   card summed the whole cluster, so Receive counted the daily backlog's
   drain as received, and called every leaf beneath the stage, each contract
   and identity step, a thing configured. *@
<section class="stages">
    @foreach (Stage stage in Stages)
    {
        IReadOnlyList<HealthRecord> inStage = InStage(stage);
        Figures counted = Surface.Stage(stage.Segment);
        FigureFlow moving = Watch(stage).Flow;
        int locations = Surface.Locations(stage.Segment).Count;
        string items = locations == 0
            ? "none configured"
            : $"{stage.Location} ×{locations} · {English.Rollup(inStage)}";
        <button class="stage @Class(inStage) @(Selected == stage ? "selected" : "")"
                @onclick="() => Select(stage)">
            <span class="name"><span class="dot"></span>@stage.Name</span>
            <span class="value">@English.Figure(counted.Of(stage.Counted))</span>
            <span class="kind">
                @English.Kind(stage.Counted) · @English.Flow(moving.Of(stage.Counted))
            </span>
            <span class="items">@items</span>
            <Why Leaf="ScopeTree.Worst(inStage)" />
        </button>
    }
</section>

@* Drill from the cluster down the scope tree to the leaf that owns the
   trouble. The drill is in the address (/?scope=…), so every step is a link
   the other views and the leaf of any Why can land on: the breadcrumb is the
   path from the cluster, each step climbing back; the rows are what sits
   directly beneath, worst first, each with its figures, and a row that is
   not fine names the leaf that explains it. At a leaf the drill ends on the
   leaf's own record. *@
<section class="drill">
    <nav class="crumbs">
        @foreach (Crumb crumb in ScopeTree.Trail(Focus, Top))
        {
            <a class="crumb-btn" href="@ScopeLink.Monitor(crumb.Scope, Carried)">@crumb.Label</a>
            <span class="sep">/</span>
        }
        <a class="crumb-link" href="@ScopeLink.Configuration(Focus, Carried)">configuration</a>
        <a class="crumb-link" href="@ScopeLink.Audit(new() { Location = Focus }, Carried)">audit</a>
    </nav>
    @{
        IReadOnlyList<Branch> branches = Filter.Only(Index.Branches(Focus));
        HealthRecord? own = Index.Own(Focus);
    }
    @if (own is not null)
    {
        @* The record published at the scope itself, whole: the bottom of the
           drill, or a Location's own verdict above what is beneath it. *@
        <div class="drill-leaf @MoodClass.Of(own.State)">
            <span class="dot" title="severity @own.Severity"></span>
            <span class="label">@ScopeTree.Name(own.Scope)</span>
            <span class="worst">@English.Mood(own.State) · severity @own.Severity</span>
            <span class="evidence">@Evidence(own)</span>
            <span class="age">@English.Age(own.Observed)</span>
            <span class="figures">@English.Figures(Surface.Figures(own.Scope))</span>
            @* A Send Port's record names the last Journey that failed there:
               its acts are offered on the spot. *@
            @if (JourneyOperation.FailedIn(own.Evidence) is not null)
            {
                <JourneyActs Surface="Surface" Record="own" Acted="Read" />
            }
        </div>
    }
    @if (branches.Count == 0 && own is null)
    {
        <p class="empty">
            @(Filter.Filtering
                ? "Nothing beneath this point matches the filter."
                : "Nothing beneath this point.")
        </p>
    }
    else if (branches.Count > 0)
    {
        <div class="branches">
            @foreach (Branch branch in branches)
            {
                string worst = branch.IsLeaf
                    ? English.Mood(branch.State)
                    : $"{branch.Count} beneath · {English.Mood(branch.State)}";
                <a class="branch @MoodClass.Of(branch.State)"
                   href="@ScopeLink.Monitor(branch.Scope, Carried)">
                    <span class="dot" title="severity @branch.Worst.Severity"></span>
                    <span class="label">@branch.Label</span>
                    <span class="worst">@worst</span>
                    @if (branch.IsLeaf)
                    {
                        <span class="evidence">@branch.Worst.Evidence</span>
                    }
                    else
                    {
                        <Why Leaf="branch.Worst" />
                    }
                    <span class="figures">@English.Figures(Surface.Figures(branch.Scope))</span>
                </a>
            }
        </div>
    }
</section>

<section class="list">
    <h2>@Heading <small>@Subheading</small></h2>
    @{
        List<HealthRecord> shown = [.. Filter.Only(Selected is null
            ? All.Where(record => record.State != HealthState.Fine)
            : InStage(Selected))];
    }
    @if (shown.Count == 0)
    {
        <p class="empty">@NothingShown</p>
    }
    else
    {
        @* Plain rows, worst first, in the list's own scroll box. Until
           2026-09-29 a Virtualize drew them: prerendered, it sent an empty
           spacer the height of every row, and the owner saw a blank area
           where 478 things needed attention. The first Shown rows are drawn
           and the rest counted; the filter narrows to them. *@
        @foreach (HealthRecord record in shown.Take(Shown))
        {
            <div class="row @MoodClass.Of(record.State)">
                <span class="dot" title="severity @record.Severity"></span>
                <a class="scope"
                   href="@ScopeLink.Monitor(record.Scope, Carried)">@ScopeTree.Name(record.Scope)</a>
                <span class="node">@ScopeTree.Node(record.Scope)</span>
                <span class="evidence">@Evidence(record)</span>
                <span class="age">@English.Age(record.Observed)</span>
                @* Paused is a mood (ADR-0041): the record says so itself. *@
                @if (Role.MayOperate() && ScopeTree.Pausable(record.Scope))
                {
                    @if (record.State == HealthState.Paused)
                    {
                        <button class="act" @onclick="() => Resume(record.Scope)">Resume</button>
                    }
                    else
                    {
                        <button class="act" @onclick="() => Pause(record.Scope)">Pause</button>
                    }
                }
                else
                {
                    <span></span>
                }
            </div>
        }
        @if (shown.Count > Shown)
        {
            <p class="empty">@English.Figure((ulong)(shown.Count - Shown)) more below these @Shown; the filter narrows to them.</p>
        }
    }
</section>

<section class="nodes">
    <h2>Nodes <small>infrastructure — where to look when a stage is not fine</small></h2>
    @if (ShownNodes.Count == 0)
    {
        <p class="empty">
            @(Filter.Filtering
                ? "No node matches the filter."
                : $"Nothing has been published — {Surface.Source}")
        </p>
    }
    else
    {
        @foreach (string nodeScope in ShownNodes)
        {
            IReadOnlyList<HealthRecord> onNode = OnNode(nodeScope);
            <div class="row @Class(onNode)">
                <span class="dot"></span>
                <a class="scope" href="@ScopeLink.Monitor(nodeScope, Carried)">
                    @ScopeTree.Parts(nodeScope).LastOrDefault()
                </a>
                <span class="node">@onNode.Count thing(s) · @English.Rollup(onNode)</span>
                <span class="evidence">@WorstEvidence(onNode)</span>
                <span class="age">@English.Figures(Surface.Figures(nodeScope))</span>
                @* An Operator can pause a whole node: it pauses everything
                   beneath the scope (ADR-0027). An Observer is shown nothing. *@
                @if (Role.MayOperate())
                {
                    @if (onNode.Any(r => r.State == HealthState.Paused))
                    {
                        <button class="act" @onclick="() => Resume(nodeScope)">Resume</button>
                    }
                    else
                    {
                        <button class="act" @onclick="() => Pause(nodeScope)">Pause</button>
                    }
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    }
</section>

@code {
    /// <summary>How many rows the list draws before it counts the rest.</summary>
    private const int Shown = 200;

    /// <summary>A stage of the message path, what it counts — the tree's own
    /// (ADR-0027 clause 5), read from ScopeTree, so the card and the figures
    /// cannot name different things — and what a thing configured at it is
    /// called.</summary>
    private sealed record Stage(string Name, string Segment, Counted Counted, string Location);

    private static readonly Stage[] Stages =
    [
        .. ScopeTree.Stages.Select(segment => new Stage(
            English.Stage(segment),
            segment,
            ScopeTree.CountedAt(segment),
            ScopeTree.Location(segment) ?? segment)),
    ];

    // The role decides whether actions are even offered (ADR-0009): an Observer
    // watches and is shown no Pause or Resume; an Operator acts.
    [Inject]
    private RoleContext Role { get; set; } = default!;

    // Read once per publication, not once per property access: the index is
    // the publication as its tree, and every question here is a lookup in it
    // (ADR-0052, amendment 2026-09-15).
    private ScopeIndex Index { get; set; } = ScopeIndex.Empty("nothing read yet");

    private IReadOnlyList<HealthRecord> All { get; set; } = [];

    private IReadOnlyDictionary<string, IReadOnlyList<HealthRecord>> ByStage { get; set; } =
        new Dictionary<string, IReadOnlyList<HealthRecord>>(StringComparer.Ordinal);

    private IReadOnlyDictionary<string, IReadOnlyList<HealthRecord>> ByNode { get; set; } =
        new Dictionary<string, IReadOnlyList<HealthRecord>>(StringComparer.Ordinal);

    // The nodes by their scopes: what the publisher draws as a node, not the
    // scopes beneath the root, which over a cluster are the cluster itself
    // (the owner, 2026-09-25: a cluster of three said "1 node(s)").
    private IReadOnlyList<string> Nodes { get; set; } = [];

    private IReadOnlyList<string> ShownNodes =>
        [.. Nodes.Where(Filter.Shows)];

    // Where the drill starts: the scope the publisher publishes at, the
    // cluster, and never the root above it (IOperatorSurface.Root).
    private string Top { get; set; } = ScopeTree.Root;

    protected override void Read()
    {
        Index = Surface.Index();
        Top = Surface.Root();
        Refilter(Index);
        All = Index.Health(ScopeTree.Root);

        // The address says where the drill is. A scope of the cluster being
        // left, or none, is the cluster itself.
        Focus = !string.IsNullOrWhiteSpace(RequestedScope) && Index.Contains(RequestedScope)
            ? RequestedScope
            : Top;

        Nodes = Surface.NodeScopes();
        ByNode = Nodes.ToDictionary(
            node => node,
            node => Index.Health(node),
            StringComparer.Ordinal);
        ByStage = ScopeTree.Stages.ToDictionary(
            stage => stage,
            stage => (IReadOnlyList<HealthRecord>)
                [.. All.Where(record => ScopeTree.Stage(record.Scope) == stage)],
            StringComparer.Ordinal);
        Watch();
    }

    private Stage? Selected { get; set; }

    private string Focus { get; set; } = ScopeTree.Root;

    // A link from any view, a crumb, a row or the leaf of a Why lands the
    // drill at that scope (ADR-0052 amendment 2026-09-14: links end where the
    // thing is).
    [SupplyParameterFromQuery(Name = "scope")]
    public string? RequestedScope { get; set; }

    // What each stage of the cluster in view is moving, per second: the one
    // watch every surface keeps between two reads (FigureWatch), never a
    // last value and a delta of the board's own. A drill redraws the same
    // publication and is no interval; another cluster starts over.
    private readonly Dictionary<string, FigureWatch> _watches = new(StringComparer.Ordinal);

    private string _watching = string.Empty;

    private FigureWatch Watch(Stage stage)
    {
        if (!_watches.TryGetValue(stage.Segment, out FigureWatch? watch))
        {
            watch = new FigureWatch();
            _watches[stage.Segment] = watch;
        }

        return watch;
    }

    private void Watch()
    {
        if (!string.Equals(_watching, Cluster, StringComparison.Ordinal))
        {
            _watches.Clear();
            _watching = Cluster;
        }

        DateTimeOffset now = DateTimeOffset.UtcNow;

        foreach (Stage stage in Stages)
        {
            Watch(stage).See(Surface.Stage(stage.Segment), now, Index.Revision);
        }
    }

    private void Select(Stage stage)
    {
        Selected = Selected == stage ? null : stage;
    }

    private void Pause(string scope)
    {
        Surface.PauseScope(scope, ScopeOperation.Who(null));
        Read();
    }

    private void Resume(string scope)
    {
        Surface.ResumeScope(scope);
        Read();
    }

    private IReadOnlyList<HealthRecord> InStage(Stage stage) =>
        ByStage.TryGetValue(stage.Segment, out IReadOnlyList<HealthRecord>? records)
            ? records
            : [];

    private IReadOnlyList<HealthRecord> OnNode(string node) =>
        ByNode.TryGetValue(node, out IReadOnlyList<HealthRecord>? records) ? records : [];

    private string Heading => Selected is null ? "Needs attention" : Selected.Name;

    private string Subheading =>
        Selected is null ? "everything not fine, worst first" : "every node, worst first";

    private string NothingShown =>
        Filter.Filtering
            ? "Nothing here matches the filter."
            : Selected is null
                ? "Nothing needs attention."
                : $"No {Selected.Name.ToLowerInvariant()} configured on any node.";

    // A leaf shows its own evidence, as it does; a node row shows the worst
    // leaf's beneath it, named, not the first record's (ADR-0052 clause 2).
    private static string Evidence(HealthRecord record) =>
        string.IsNullOrEmpty(record.Evidence) ? "—" : record.Evidence;

    // A fine node has nothing to explain (Why says nothing for Fine either);
    // until 2026-09-26 its row showed whichever fine leaf stood first, as if
    // it were the reason for something.
    private static string WorstEvidence(IReadOnlyList<HealthRecord> records)
    {
        HealthRecord? worst = ScopeTree.Worst(records);

        return worst is null || worst.State == HealthState.Fine
            || string.IsNullOrEmpty(worst.Evidence)
            ? "—"
            : $"{ScopeTree.Name(worst.Scope)}: {worst.Evidence}";
    }

    // The classes carry the mood and its color's name, and the stylesheet
    // paints the name (ADR-0041): the rollup for a set of leaves, or "none"
    // when nothing is recorded.
    private static string Class(IReadOnlyList<HealthRecord> records) =>
        MoodClass.Of(records);
}
