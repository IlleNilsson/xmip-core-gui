@page "/"
@using Xmip.Gui.Surface
@implements IDisposable

<PageTitle>Xmip — Cluster</PageTitle>

<header class="bar">
    <img class="logo" src="_content/Xmip.Gui/xmip-logo.png" alt="Xmip" />
    <span class="crumb">cluster</span>
    <span class="source @(IsSample ? "sample" : "")">@Surface.Source</span>
</header>

@* The cluster: how it is, and what it moves. An operator runs the message
   path — Receive, Process, Send — and looks at a node only when a stage is
   red. So the stages are the landing page and the nodes are at the bottom. *@
<section class="cluster @WorstClass(All)">
    <span class="dot"></span>
    <span class="state">@WorstLabel(All)</span>
    <span class="detail">@Nodes.Count node(s) · @All.Count thing(s) observed</span>
</section>

<section class="stages">
    @foreach (Stage stage in Stages)
    {
        IReadOnlyList<HealthRecord> inStage = InStage(stage);
        MeasurementRecord? moved = Surface.Measure(Scope, stage.Counted);
        <button class="stage @WorstClass(inStage) @(Selected == stage ? "selected" : "")"
                @onclick="() => Select(stage)">
            <span class="name"><span class="dot" style="@DotStyle(inStage)"></span>@stage.Name</span>
            <span class="value">@Format(moved)</span>
            <span class="kind">@stage.Counted.ToString().ToLowerInvariant(), last minute</span>
            <span class="items">@(inStage.Count == 0 ? "none configured" : $"{inStage.Count} configured · {WorstLabel(inStage)}")</span>
        </button>
    }
</section>

@* Drill from the cluster down the scope tree to the lowest point where an error
   is. The breadcrumb is the path to here and each step climbs back; the rows are
   what sits directly beneath, worst first, and clicking one descends. "Follow
   the error" jumps straight to the parent of the worst leaf. *@
<section class="drill">
    <nav class="crumbs">
        @foreach ((string label, string scope) in Trail(Focus))
        {
            <button class="crumb-btn" @onclick="() => Focus = scope">@label</button>
            <span class="sep">/</span>
        }
        @if (WorstLeaf is not null && WorstLeaf.State != HealthState.Green)
        {
            <button class="to-error" @onclick="FollowError">follow the error →</button>
        }
    </nav>
    @{
        IReadOnlyList<Branch> branches = Branches(Focus);
    }
    @if (branches.Count == 0)
    {
        <p class="empty">Nothing beneath this point.</p>
    }
    else
    {
        <div class="branches">
            @foreach (Branch branch in branches)
            {
                <button class="branch @branch.State.ToString().ToLowerInvariant()"
                        @onclick="() => Focus = branch.Scope">
                    <span class="dot" style="@DotStyle(branch.Severity, branch.State)"></span>
                    <span class="label">@branch.Label</span>
                    <span class="worst">@(branch.IsLeaf ? branch.State.ToString().ToLowerInvariant() : $"{branch.Count} beneath · {WorstLabelFor(branch.State)}")</span>
                    <span class="evidence">@(branch.IsLeaf && !string.IsNullOrEmpty(branch.Evidence) ? branch.Evidence : "")</span>
                </button>
            }
        </div>
    }
</section>

<section class="list">
    <h2>@(Selected is null ? "Needs attention" : Selected.Name) <small>@(Selected is null ? "everything not green, worst first" : "every node, worst first")</small></h2>
    @{
        IReadOnlyList<HealthRecord> shown = Selected is null
            ? All.Where(r => r.State != HealthState.Green).ToList()
            : InStage(Selected);
    }
    @if (shown.Count == 0)
    {
        <p class="empty">@(Selected is null ? "Nothing needs attention." : $"No {Selected.Name.ToLowerInvariant()} configured on any node.")</p>
    }
    else
    {
        @foreach (HealthRecord record in shown)
        {
            <div class="row @record.State.ToString().ToLowerInvariant()">
                <span class="dot" style="@DotStyle(record.Severity, record.State)" title="severity @record.Severity"></span>
                <span class="scope">@Name(record.Scope)</span>
                <span class="node">@Node(record.Scope)</span>
                <span class="evidence">@(string.IsNullOrEmpty(record.Evidence) ? "—" : record.Evidence)</span>
                <span class="age">@Age(record.Observed)</span>
                @if (IsPausable(record.Scope))
                {
                    @if (record.Evidence.StartsWith("paused by", StringComparison.Ordinal))
                    {
                        <button class="act" @onclick="() => Resume(record.Scope)">Resume</button>
                    }
                    else
                    {
                        <button class="act" @onclick="() => Pause(record.Scope)">Pause</button>
                    }
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    }
</section>

<section class="nodes">
    <h2>Nodes <small>infrastructure — where to look when a stage is red</small></h2>
    @if (Nodes.Count == 0)
    {
        <p class="empty">
            No node has published. To start one, set <code>Xmip:NodeConfiguration</code> in
            <code>xmip.gui.toml</code> to a node TOML — <code>samples/edge-01.xmip.toml</code>
            is one — and restart.
        </p>
    }
    else
    {
        @foreach (string node in Nodes)
        {
            IReadOnlyList<HealthRecord> onNode = All.Where(r => Node(r.Scope) == node).ToList();
            <div class="row @WorstClass(onNode)">
                <span class="dot"></span>
                <span class="scope">@node</span>
                <span class="node">@onNode.Count thing(s)</span>
                <span class="evidence">@(onNode.FirstOrDefault()?.Evidence ?? "—")</span>
                <span class="age">@WorstLabel(onNode)</span>
            </div>
        }
    }
</section>

@code {
    private const string Scope = "xmip:///";

    /// <summary>A stage of the message path, and what it counts.</summary>
    private sealed record Stage(string Name, string Segment, Counted Counted);

    private static readonly Stage[] Stages =
    [
        new("Receive", "receive", Counted.Streams),
        new("Process", "process", Counted.Journeys),
        new("Send", "send", Counted.Messages),
    ];

    [Inject]
    private IOperatorSurface Surface { get; set; } = default!;

    // Read once per render, not once per property access — every read is a
    // call across the boundary.
    private IReadOnlyList<HealthRecord> All { get; set; } = [];

    private Stage? Selected { get; set; }

    private System.Threading.Timer? _refresh;

    protected override void OnParametersSet()
    {
        All = Surface.Health(Scope);
    }

    protected override void OnInitialized()
    {
        // A monitoring page refreshes itself, so an operator watches the estate
        // change over time — the pingpong test rolling, a stage turning red —
        // without touching the browser. Two seconds is live enough to feel it
        // and slow enough to stay cheap across the boundary.
        _refresh = new System.Threading.Timer(
            _ => InvokeAsync(() =>
            {
                All = Surface.Health(Scope);
                StateHasChanged();
            }),
            null,
            TimeSpan.FromSeconds(2),
            TimeSpan.FromSeconds(2));
    }

    public void Dispose() => _refresh?.Dispose();

    // ---- Drill-down: from the cluster to the lowest point where an error is ----

    private string Focus { get; set; } = Scope;

    private sealed record Branch(
        string Scope, string Label, HealthState State, byte Severity, string Evidence, bool IsLeaf, int Count);

    // The path from the cluster to the current focus, each step a place to climb
    // back to.
    private IReadOnlyList<(string Label, string Scope)> Trail(string focus)
    {
        List<(string, string)> trail = [("cluster", Scope)];
        string accumulated = "xmip:///";
        foreach (string segment in Parts(focus))
        {
            accumulated = accumulated.TrimEnd('/') + "/" + segment;
            trail.Add((segment, accumulated));
        }
        return trail;
    }

    // What sits directly beneath the focus: every record beneath it grouped by
    // its next path segment, each group rolled up to its worst.
    private IReadOnlyList<Branch> Branches(string focus)
    {
        int depth = Parts(focus).Length;

        return All
            .Where(record => Beneath(record.Scope, focus))
            .GroupBy(record => string.Join('/', Parts(record.Scope).Take(depth + 1)))
            .Select(group =>
            {
                HealthRecord worst = group
                    .OrderByDescending(r => r.State)
                    .ThenByDescending(r => r.Severity)
                    .First();
                bool isLeaf = group.All(r => Parts(r.Scope).Length == depth + 1);
                string label = Parts("xmip:///" + group.Key).LastOrDefault() ?? group.Key;
                return new Branch(
                    "xmip:///" + group.Key, label, worst.State, worst.Severity,
                    isLeaf ? worst.Evidence : "", isLeaf, group.Count());
            })
            .OrderByDescending(b => b.State)
            .ThenByDescending(b => b.Severity)
            .ThenBy(b => b.Label, StringComparer.Ordinal)
            .ToList();
    }

    private HealthRecord? WorstLeaf
    {
        get
        {
            return All
                .OrderByDescending(r => r.State)
                .ThenByDescending(r => r.Severity)
                .FirstOrDefault();
        }
    }

    private void FollowError()
    {
        if (WorstLeaf is not null)
        {
            Focus = ParentScope(WorstLeaf.Scope);
        }
    }

    private static string ParentScope(string scope)
    {
        string[] parts = Parts(scope);
        return parts.Length <= 1
            ? "xmip:///"
            : "xmip:///" + string.Join('/', parts.Take(parts.Length - 1));
    }

    // Beneath in the scope tree: the focus's segments are a prefix of the
    // candidate's. The cluster root has no segments, so everything is beneath it.
    private static bool Beneath(string candidate, string focus)
    {
        string[] want = Parts(focus);
        string[] have = Parts(candidate);
        if (have.Length < want.Length)
        {
            return false;
        }
        for (int index = 0; index < want.Length; index++)
        {
            if (have[index] != want[index])
            {
                return false;
            }
        }
        return true;
    }

    private static string WorstLabelFor(HealthState state)
    {
        return state.ToString().ToLowerInvariant();
    }

    private void Select(Stage stage)
    {
        Selected = Selected == stage ? null : stage;
    }

    private void Pause(string scope)
    {
        Surface.PauseScope(scope, "operator");
        All = Surface.Health(Scope);
    }

    private void Resume(string scope)
    {
        Surface.ResumeScope(scope);
        All = Surface.Health(Scope);
    }

    // Receive and Send Locations can be paused; a Process runs off a
    // subscription and an operator pauses the Location that feeds it, not the
    // Process itself.
    private static bool IsPausable(string scope)
    {
        string stage = Segment(scope, 1);
        return stage is "receive" or "send";
    }

    // The dot's colour is the state; its depth is the severity. A light yellow
    // at 40 and a deep amber at 85 are both "yellow", and the operator sees
    // which without reading the number.
    private static string DotStyle(byte severity, HealthState state)
    {
        // 0 keeps the flat state colour; higher darkens toward the edge of the
        // band. Kept in the page rather than the stylesheet because it is a
        // computed value per row.
        double weight = severity / 100.0;
        string shade = state switch
        {
            HealthState.Green => Mix("#1f9d55", "#146638", weight),
            HealthState.Yellow => Mix("#e9c46a", "#c0791f", weight),
            HealthState.Red => Mix("#e06666", "#8f1d1d", weight),
            _ => "#6b7280",
        };
        return $"background:{shade}";
    }

    private static string DotStyle(IReadOnlyList<HealthRecord> records)
    {
        HealthRecord? worst = records
            .OrderByDescending(r => r.State)
            .ThenByDescending(r => r.Severity)
            .FirstOrDefault();
        return worst is null ? "" : DotStyle(worst.Severity, worst.State);
    }

    private static string Mix(string light, string dark, double weight)
    {
        (int lr, int lg, int lb) = Rgb(light);
        (int dr, int dg, int db) = Rgb(dark);
        int r = (int)(lr + (dr - lr) * weight);
        int g = (int)(lg + (dg - lg) * weight);
        int b = (int)(lb + (db - lb) * weight);
        return $"#{r:x2}{g:x2}{b:x2}";
    }

    private static (int, int, int) Rgb(string hex) =>
        (Convert.ToInt32(hex.Substring(1, 2), 16),
         Convert.ToInt32(hex.Substring(3, 2), 16),
         Convert.ToInt32(hex.Substring(5, 2), 16));

    private bool IsSample => Surface.Source.StartsWith("SAMPLE", StringComparison.Ordinal);

    private IReadOnlyList<string> Nodes =>
        All.Select(r => Node(r.Scope)).Where(n => n.Length > 0).Distinct().Order().ToList();

    private IReadOnlyList<HealthRecord> InStage(Stage stage) =>
        All.Where(r => Segment(r.Scope, 1) == stage.Segment).ToList();

    // xmip:///<node>/<stage>/<name>. The node is where a thing runs; the stage
    // is what it is. Nothing here is a level an operator has to descend.
    private static string[] Parts(string scope) =>
        scope.Replace("xmip:///", "", StringComparison.Ordinal).Split('/', StringSplitOptions.RemoveEmptyEntries);

    private static string Node(string scope) => Parts(scope).ElementAtOrDefault(0) ?? "";

    private static string Segment(string scope, int index) => Parts(scope).ElementAtOrDefault(index) ?? "";

    private static string Name(string scope)
    {
        string[] parts = Parts(scope);
        return parts.Length >= 3 ? string.Join('/', parts.Skip(2)) : (parts.Length == 2 ? parts[1] : scope);
    }

    // observability-model.md section 6: the worst state beneath is the state
    // shown. Nothing recorded is not green — it answered,
    // and had nothing to say.
    private static string WorstLabel(IReadOnlyList<HealthRecord> records) =>
        records.Count == 0 ? "nothing recorded" : records.Max(r => r.State).ToString().ToLowerInvariant();

    private static string WorstClass(IReadOnlyList<HealthRecord> records) =>
        records.Count == 0 ? "none" : records.Max(r => r.State).ToString().ToLowerInvariant();

    private static string Format(MeasurementRecord? measured)
    {
        return measured switch
        {
            null => "–",
            { Counted: Counted.Bytes } bytes => Bytes(bytes.Value),
            { } count => count.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture),
        };
    }

    private static string Bytes(ulong value)
    {
        return value switch
        {
            >= 1_000_000_000 => $"{value / 1_000_000_000.0:F1} GB",
            >= 1_000_000 => $"{value / 1_000_000.0:F1} MB",
            >= 1_000 => $"{value / 1_000.0:F1} kB",
            _ => $"{value} B",
        };
    }

    private static string Age(DateTimeOffset observed)
    {
        TimeSpan age = DateTimeOffset.UtcNow - observed;

        return age.TotalSeconds < 60
            ? $"{(int)age.TotalSeconds}s ago"
            : $"{(int)age.TotalMinutes}m ago";
    }
}
