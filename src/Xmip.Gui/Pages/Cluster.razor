@page "/"
@using Xmip.Gui.Surface
@implements IDisposable

<PageTitle>Xmip — Cluster</PageTitle>

<header class="bar">
    <img class="logo" src="_content/Xmip.Gui/xmip-logo.png" alt="Xmip" />
    <span class="crumb">cluster</span>
    <span class="source">@Surface.Source</span>
</header>

@* The cluster: how it is, and what it moves. An operator runs the message
   path — Receive, Process, Send — and looks at a node only when a stage is
   not Fine. So the stages are the landing page and the nodes are at the
   bottom. A scope that is Holding says why on the spot: the worst leaf
   beneath it and that leaf's evidence (ADR-0052 clause 2). *@
<section class="cluster @Class(All)">
    <span class="dot"></span>
    <span class="state">@English.Rollup(All)</span>
    <Why Leaf="ScopeTree.Worst(All)" />
    <span class="detail">@Nodes.Count node(s) · @All.Count thing(s) observed</span>
</section>

<section class="stages">
    @foreach (Stage stage in Stages)
    {
        IReadOnlyList<HealthRecord> inStage = InStage(stage);
        MeasurementRecord? moved = Surface.Measure(ScopeTree.Root, stage.Counted);
        <button class="stage @Class(inStage) @(Selected == stage ? "selected" : "")"
                @onclick="() => Select(stage)">
            <span class="name"><span class="dot"></span>@stage.Name</span>
            <span class="value">@English.Count(moved)</span>
            <span class="kind">@stage.Counted.ToString().ToLowerInvariant(), last minute</span>
            <span class="items">@(inStage.Count == 0 ? "none configured" : $"{inStage.Count} configured · {English.Rollup(inStage)}")</span>
            <Why Leaf="ScopeTree.Worst(inStage)" />
        </button>
    }
</section>

@* Drill from the cluster down the scope tree to the leaf that owns the
   trouble. The breadcrumb is the path to here and each step climbs back; the
   rows are what sits directly beneath, worst first, and clicking one
   descends. There is no shortcut to the error: a Holding row already says
   which leaf and why, and the operator drills, or reads the audit. *@
<section class="drill">
    <nav class="crumbs">
        @foreach (Crumb crumb in ScopeTree.Trail(Focus))
        {
            <button class="crumb-btn" @onclick="() => Focus = crumb.Scope">@crumb.Label</button>
            <span class="sep">/</span>
        }
    </nav>
    @{
        IReadOnlyList<Branch> branches = ScopeTree.Branches(All, Focus);
    }
    @if (branches.Count == 0)
    {
        <p class="empty">Nothing beneath this point.</p>
    }
    else
    {
        <div class="branches">
            @foreach (Branch branch in branches)
            {
                <button class="branch @English.Mood(branch.State)" @onclick="() => Focus = branch.Scope">
                    <span class="dot" title="severity @branch.Worst.Severity"></span>
                    <span class="label">@branch.Label</span>
                    <span class="worst">@(branch.IsLeaf ? English.Mood(branch.State) : $"{branch.Count} beneath · {English.Mood(branch.State)}")</span>
                    @if (branch.IsLeaf)
                    {
                        <span class="evidence">@branch.Worst.Evidence</span>
                    }
                    else
                    {
                        <Why Leaf="branch.Worst" />
                    }
                </button>
            }
        </div>
    }
</section>

<section class="list">
    <h2>@(Selected is null ? "Needs attention" : Selected.Name) <small>@(Selected is null ? "everything not fine, worst first" : "every node, worst first")</small></h2>
    @{
        IReadOnlyList<HealthRecord> shown = Selected is null
            ? All.Where(r => r.State != HealthState.Fine).ToList()
            : InStage(Selected);
    }
    @if (shown.Count == 0)
    {
        <p class="empty">@(Selected is null ? "Nothing needs attention." : $"No {Selected.Name.ToLowerInvariant()} configured on any node.")</p>
    }
    else
    {
        @foreach (HealthRecord record in shown)
        {
            <div class="row @English.Mood(record.State)">
                <span class="dot" title="severity @record.Severity"></span>
                <span class="scope">@ScopeTree.Name(record.Scope)</span>
                <span class="node">@ScopeTree.Node(record.Scope)</span>
                <span class="evidence">@(string.IsNullOrEmpty(record.Evidence) ? "—" : record.Evidence)</span>
                <span class="age">@English.Age(record.Observed)</span>
                @* Paused is a mood (ADR-0041): the record says so itself. *@
                @if (Role.MayOperate() && IsPausable(record.Scope))
                {
                    @if (record.State == HealthState.Paused)
                    {
                        <button class="act" @onclick="() => Resume(record.Scope)">Resume</button>
                    }
                    else
                    {
                        <button class="act" @onclick="() => Pause(record.Scope)">Pause</button>
                    }
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    }
</section>

<section class="nodes">
    <h2>Nodes <small>infrastructure — where to look when a stage is not fine</small></h2>
    @if (Nodes.Count == 0)
    {
        <p class="empty">Nothing has been published — @Surface.Source</p>
    }
    else
    {
        @foreach (string node in Nodes)
        {
            IReadOnlyList<HealthRecord> onNode = All.Where(r => ScopeTree.Node(r.Scope) == node).ToList();
            HealthRecord? worst = ScopeTree.Worst(onNode);
            string nodeScope = ScopeTree.Root + node;
            <div class="row @Class(onNode)">
                <span class="dot"></span>
                <span class="scope">@node</span>
                <span class="node">@onNode.Count thing(s)</span>
                <span class="evidence">@(worst is null || string.IsNullOrEmpty(worst.Evidence) ? "—" : $"{ScopeTree.Name(worst.Scope)}: {worst.Evidence}")</span>
                <span class="age">@English.Rollup(onNode)</span>
                @* An Operator can pause a whole node: it pauses everything
                   beneath the scope (ADR-0027). An Observer is shown nothing. *@
                @if (Role.MayOperate())
                {
                    @if (onNode.Any(r => r.State == HealthState.Paused))
                    {
                        <button class="act" @onclick="() => Resume(nodeScope)">Resume</button>
                    }
                    else
                    {
                        <button class="act" @onclick="() => Pause(nodeScope)">Pause</button>
                    }
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    }
</section>

@code {
    /// <summary>A stage of the message path, and what it counts.</summary>
    private sealed record Stage(string Name, string Segment, Counted Counted);

    private static readonly Stage[] Stages =
    [
        new("Receive", "receive", Counted.Streams),
        new("Process", "process", Counted.Journeys),
        new("Send", "send", Counted.Messages),
    ];

    [Inject]
    private IOperatorSurface Surface { get; set; } = default!;

    // The role decides whether actions are even offered (ADR-0009): an Observer
    // watches and is shown no Pause or Resume; an Operator acts.
    [Inject]
    private RoleContext Role { get; set; } = default!;

    // Read once per render, not once per property access — every read is a
    // call across the boundary.
    private IReadOnlyList<HealthRecord> All { get; set; } = [];

    private Stage? Selected { get; set; }

    private string Focus { get; set; } = ScopeTree.Root;

    private System.Threading.Timer? _refresh;

    protected override void OnParametersSet()
    {
        All = Surface.Health(ScopeTree.Root);
    }

    protected override void OnInitialized()
    {
        // A monitoring page refreshes itself, so an operator watches the estate
        // change over time — the pingpong test rolling, a stage turning Done —
        // without touching the browser. Two seconds is live enough to feel it
        // and slow enough to stay cheap across the boundary.
        _refresh = new System.Threading.Timer(
            _ => InvokeAsync(() =>
            {
                All = Surface.Health(ScopeTree.Root);
                StateHasChanged();
            }),
            null,
            TimeSpan.FromSeconds(2),
            TimeSpan.FromSeconds(2));
    }

    public void Dispose() => _refresh?.Dispose();

    private void Select(Stage stage)
    {
        Selected = Selected == stage ? null : stage;
    }

    private void Pause(string scope)
    {
        Surface.PauseScope(scope, "operator");
        All = Surface.Health(ScopeTree.Root);
    }

    private void Resume(string scope)
    {
        Surface.ResumeScope(scope);
        All = Surface.Health(ScopeTree.Root);
    }

    // Receive and Send Locations can be paused; a Process runs off a
    // subscription and an operator pauses the Location that feeds it, not the
    // Process itself.
    private static bool IsPausable(string scope)
    {
        return ScopeTree.Segment(scope, 1) is "receive" or "send";
    }

    private IReadOnlyList<string> Nodes =>
        All.Select(r => ScopeTree.Node(r.Scope)).Where(n => n.Length > 0).Distinct().Order().ToList();

    private IReadOnlyList<HealthRecord> InStage(Stage stage) =>
        All.Where(r => ScopeTree.Segment(r.Scope, 1) == stage.Segment).ToList();

    // The class carries the mood and the stylesheet paints it (ADR-0041): the
    // rollup word for a set of leaves, or "none" when nothing is recorded.
    private static string Class(IReadOnlyList<HealthRecord> records) =>
        records.Count == 0 ? "none" : English.Rollup(records);
}
