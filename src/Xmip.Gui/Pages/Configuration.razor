@page "/configuration"
@using Xmip.Gui.Surface
@inherits ClusterView

<PageTitle>Xmip — Configuration</PageTitle>

<RunLine Run="Surface.Run()" Cluster="@Cluster" Source="@Surface.Source" />

<ScopeFilterBox Id="filter-configuration" Pattern="@Pattern" PatternChanged="Filtered"
                Said="@Filter.Said" />

@* The classic tree (the owner, 2026-09-14; ADR-0052 amendment 2026-09-14,
   ruling 1): the whole cluster, every node, receive → process → send beneath
   each, and every Location, Xmip Process and technology beneath those, in
   configuration order, holding still. The monitor moves and sorts by
   trouble; this view does neither, so an operator can find a thing by where
   it is declared and read what it is. Cluster, node and stage stand open;
   deeper branches open on a click — the browser's own details element, no
   script. A row links to the monitor's drill at that scope. What a surface
   does not publish — the declaration behind a scope, the binaries a node
   runs — is not invented here.

   Drilling to the problem (the owner, 2026-09-18: the severity is there and
   the way to the problem area is not): a branch that is not fine names the
   leaf that explains it, and links to that leaf's row; the branches on the
   way to it stand open however deep, so the link lands on something
   visible and the eye can follow the path without a click. *@
<section class="tree">
    @if (All.Count == 0)
    {
        <p class="empty">Nothing observed yet: no node has published a scope.</p>
    }
    else
    {
        @* The cluster is the tree's first row and nothing else heads it. Until
           2026-09-25 a row of its own stood above the tree saying the cluster
           again — its name, its mood, its worst leaf — and the tree's first
           row said the same beneath it (the owner: *two headers for the
           cluster*). That row is the tree's cluster row now, and the links
           it carried are on it. *@
        @Level(ScopeTree.Root, 1, RootWorst?.Scope, Carried, null)
    }
</section>

@code {
    private IReadOnlyList<HealthRecord> All { get; set; } = [];

    // The publication as its tree, built once per read (ADR-0052, amendment
    // 2026-09-15): every level here is a lookup, put into configuration order.
    private ScopeIndex Index { get; set; } = ScopeIndex.Empty("nothing read yet");

    // The tree keeps the path down to what matched, however deep, so a row a
    // pattern names can still be reached; a row that matched shows everything
    // beneath it, because a node named whole is a node with its own tree.
    private string Pattern { get; set; } = string.Empty;

    private ScopeFilter Filter { get; set; } = ScopeFilter.None;

    private void Filtered(string pattern)
    {
        Pattern = pattern;
        Read();
    }

    // Levels that stand open without a click: the cluster, its nodes and the
    // stage beneath each; the playground puts its nodes under a `node`
    // segment, so one more level than a configured cluster would need.
    private const int OpenDepth = 4;

    // The leaf that explains the cluster's mood: the worst beneath the root.
    private HealthRecord? RootWorst => ScopeTree.Worst(All);

    // What the publisher says each drawn thing is, by its scope: the
    // topology's own kinds (observe::topology), read with the rest of the
    // publication. A row takes its kind from here where the publisher said
    // one, and its place in the topology — a node on it opens there.
    private IReadOnlyDictionary<string, TopologyNode> Drawn { get; set; } =
        new Dictionary<string, TopologyNode>();

    private IReadOnlySet<string> Opens { get; set; } = new HashSet<string>();

    protected override void Read()
    {
        Index = Surface.Index();
        All = Index.Health(ScopeTree.Root);
        Filter = ScopeFilter.Over(Index, Pattern);

        TopologySnapshot topology = Surface.Topology();
        Drawn = topology.Nodes
            .GroupBy(node => node.Scope, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
        Opens = topology.Nodes
            .Where(node => node.ParentId is not null)
            .Select(node => node.ParentId!)
            .ToHashSet(StringComparer.Ordinal);
    }

    // One level of the tree beneath a scope. Configuration order, not trouble
    // order: the three stages in the order the message path runs them,
    // everything else by name. A branch with children is a details element,
    // open down to the stage, and open beyond it where it lies on the way to
    // `trouble`, the leaf that explains its parent; a leaf is its row.
    private RenderFragment Level(
        string scope, int depth, string? trouble, string? cluster, string? above) =>
        __builder =>
    {
        IReadOnlyList<Branch> branches =
        [
            .. Filter.Only(Index.Branches(scope))
                .OrderBy(branch => StageOrder(branch.Label))
                .ThenBy(branch => branch.Label, StringComparer.Ordinal),
        ];

        if (branches.Count == 0)
        {
            return;
        }

        <ul class="tree-level">
            @foreach (Branch branch in branches)
            {
                <li class="tree-item">
                    @if (branch.IsLeaf)
                    {
                        @Row(branch, cluster, Kind(branch.Scope, above))
                    }
                    else
                    {
                        string kind = Kind(branch.Scope, above);
                        @* A filtered tree stands open to what it kept: the
                           rows are few, and the operator asked for them. *@
                        <details open="@(Filter.Filtering
                                         || depth < OpenDepth
                                         || OnTheWay(branch.Scope, trouble))">
                            <summary>@Row(branch, cluster, kind)</summary>
                            @Level(branch.Scope, depth + 1, TroubleBeneath(branch), cluster, kind)
                        </details>
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment Row(Branch branch, string? cluster, string kind) => __builder =>
    {
        string mood = English.Mood(branch.State);
        bool troubled = !branch.IsLeaf && branch.State != HealthState.Fine;
        <div class="tree-row @MoodClass.Of(branch.State)" id="@ScopeLink.Anchor(branch.Scope)">
            <span class="dot" title="severity @branch.Worst.Severity"></span>
            <span class="kind">@kind</span>
            <span class="label">@branch.Label</span>
            <span class="mood">@mood</span>
            <span class="evidence" title="@Said(branch, troubled)">@Said(branch, troubled)</span>
            <span class="tree-links">
                @if (troubled)
                {
                    <a class="tree-link problem"
                       href="@ScopeLink.Configuration(branch.Worst.Scope, cluster)">problem</a>
                }
                <a class="tree-link" href="@ScopeLink.Monitor(branch.Scope, cluster)">monitor</a>
                @if (Topology(branch.Scope, cluster) is { } drawn)
                {
                    <a class="tree-link" href="@drawn">topology</a>
                }
            </span>
        </div>
    };

    // The same scope on the Topology, where the publisher drew it: opened
    // there when something is beneath it, else its parent opened, so the
    // thing is on the canvas. Nothing where it drew no such thing.
    private string? Topology(string scope, string? cluster)
    {
        if (!Drawn.TryGetValue(scope, out TopologyNode? node))
        {
            return null;
        }

        return Opens.Contains(node.Id)
            ? ScopeLink.TopologyAt(node.Id, cluster)
            : node.ParentId is { } parent
                ? ScopeLink.TopologyAt(parent, cluster)
                : ScopeLink.Topology(cluster);
    }

    // A leaf says its evidence; a fine branch how much is beneath it; a
    // troubled branch where the trouble is and what it says.
    private static string Said(Branch branch, bool troubled)
    {
        if (branch.IsLeaf)
        {
            return branch.Worst.Evidence;
        }

        // A row whose own record is the worst says so rather than naming an
        // empty path to itself.
        string where = branch.Worst.Scope == branch.Scope
            ? "its own"
            : $"worst {Relative(branch.Scope, branch.Worst.Scope)}";

        return troubled
            ? $"{branch.Count} beneath — {where}: {branch.Worst.Evidence}"
            : $"{branch.Count} beneath";
    }

    // The leaf that explains a branch, where the branch is not fine.
    private static string? TroubleBeneath(Branch branch) =>
        branch.State == HealthState.Fine ? null : branch.Worst.Scope;

    private static bool OnTheWay(string scope, string? trouble) =>
        trouble is not null
        && (trouble == scope || trouble.StartsWith(scope + "/", StringComparison.Ordinal));

    // A scope as it reads from a scope above it: the segments between them.
    private static string Relative(string from, string scope) =>
        string.Join('/', ScopeTree.Parts(scope).Skip(ScopeTree.Parts(from).Length));

    // What a scope is. What a node declares it can do is the node's own
    // statement (ADR-0056); where a node publishes it is observe's to say, not
    // a leaf's name. Then what the publisher's topology says the thing is —
    // cluster, node, stage, endpoint — and beneath an endpoint, the
    // technology. Until 2026-09-25 the kind was read from the depth alone,
    // which a Playground cluster, its nodes beneath a `node` segment, put one
    // level off: the rollup branch said NODE, the node said SCOPE and the
    // receive stage said RECEIVE LOCATION. Where no topology is published the
    // depth is all there is: the record names cluster, node and the three
    // stages; beneath a stage sits the Location or Xmip Process and beneath
    // that the technology (ADR-0027).
    private string Kind(string scope, string? above)
    {
        if (NodeCapability.Declared(scope, string.Empty) is not null)
        {
            return "capability";
        }

        if (Drawn.TryGetValue(scope, out TopologyNode? drawn))
        {
            return English.Name(drawn.Kind);
        }

        string beneathEndpoint = English.Name(TopologyNodeKind.Endpoint);

        if (Drawn.Count > 0)
        {
            return above == beneathEndpoint || above == "technology" ? "technology" : "scope";
        }

        string[] parts = ScopeTree.Parts(scope);

        return parts.Length switch
        {
            1 => "cluster",
            2 => "node",
            3 when ScopeTree.Stages.Contains(parts[2]) => "stage",
            3 => "scope",
            4 => ScopeTree.Location(ScopeTree.Stage(scope)) ?? "technology",
            _ => "technology",
        };
    }

    private static int StageOrder(string label)
    {
        int index = ScopeTree.Stages.ToList().IndexOf(label);
        return index < 0 ? ScopeTree.Stages.Count : index;
    }
}
