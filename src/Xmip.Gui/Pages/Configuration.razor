@page "/configuration"
@using Xmip.Gui.Surface
@implements IDisposable

<PageTitle>Xmip — Configuration</PageTitle>

<header class="bar">
    <img class="logo" src="_content/Xmip.Gui/xmip-logo.png" alt="Xmip" />
    <span class="crumb">configuration</span>
    <span class="source">@Surface.Source</span>
</header>

@* The classic tree (the owner, 2026-09-14; ADR-0052 amendment 2026-09-14,
   ruling 1): the whole cluster, every node, receive → process → send beneath
   each, and every Location, Xmip Process and technology beneath those, in
   configuration order, holding still. The monitor moves and sorts by
   trouble; this view does neither, so an operator can find a thing by where
   it is declared and read what it is. Cluster, node and stage stand open;
   deeper branches open on a click — the browser's own details element, no
   script. A row links to the monitor's drill at that scope. What a surface
   does not publish — the declaration behind a scope, the binaries a node
   runs — is not invented here. *@
<section class="tree">
    @if (All.Count == 0)
    {
        <p class="empty">Nothing observed yet: no node has published a scope.</p>
    }
    else
    {
        <div class="tree-row @English.Mood(RootState)">
            <span class="dot"></span>
            <span class="kind">cluster</span>
            <span class="label">@ClusterName</span>
            <span class="mood">@English.Mood(RootState)</span>
            <span class="evidence">@All.Count thing(s) observed</span>
            <a class="tree-link" href="/topology">topology</a>
        </div>
        @Level(ScopeTree.Root, 1)
    }
</section>

@code {
    [Inject]
    private IOperatorSurface Surface { get; set; } = default!;

    private IReadOnlyList<HealthRecord> All { get; set; } = [];

    // The publication as its tree, built once per read (ADR-0052, amendment
    // 2026-09-15): every level here is a lookup, put into configuration order.
    private ScopeIndex Index { get; set; } = ScopeIndex.Empty("nothing read yet");

    private readonly CancellationTokenSource _stop = new();

    // Levels that stand open without a click: the cluster, its nodes and the
    // stage beneath each; the playground puts its nodes under a `node`
    // segment, so one more level than a configured cluster would need.
    private const int OpenDepth = 4;

    private HealthState RootState => ScopeTree.Rollup(All) ?? HealthState.Working;

    // The cluster is the first segment beneath the root — one cluster per
    // surface today; the topology's navigation between clusters is queued.
    private string ClusterName =>
        All.Select(record => ScopeTree.Segment(record.Scope, 0))
            .FirstOrDefault(name => !string.IsNullOrEmpty(name)) ?? "cluster";

    protected override void OnInitialized()
    {
        Read();
        _ = ObserveAsync();
    }

    private async Task ObserveAsync()
    {
        try
        {
            await foreach (SurfaceChange _ in Surface.WatchAsync(_stop.Token))
            {
                await InvokeAsync(() =>
                {
                    Read();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Leaving the page is the normal end of its subscription.
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }

    private void Read()
    {
        Index = Surface.Index();
        All = Index.Health(ScopeTree.Root);
    }

    // One level of the tree beneath a scope. Configuration order, not trouble
    // order: the three stages in the order the message path runs them,
    // everything else by name. A branch with children is a details element,
    // open down to the stage; a leaf is its row.
    private RenderFragment Level(string scope, int depth) => __builder =>
    {
        IReadOnlyList<Branch> branches =
        [
            .. Index.Branches(scope)
                .OrderBy(branch => StageOrder(branch.Label))
                .ThenBy(branch => branch.Label, StringComparer.Ordinal),
        ];

        if (branches.Count == 0)
        {
            return;
        }

        <ul class="tree-level">
            @foreach (Branch branch in branches)
            {
                <li class="tree-item">
                    @if (branch.IsLeaf)
                    {
                        @Row(branch)
                    }
                    else
                    {
                        <details open="@(depth < OpenDepth)">
                            <summary>@Row(branch)</summary>
                            @Level(branch.Scope, depth + 1)
                        </details>
                    }
                </li>
            }
        </ul>
    };

    private static RenderFragment Row(Branch branch) => __builder =>
    {
        string mood = English.Mood(branch.State);
        <div class="tree-row @mood">
            <span class="dot" title="severity @branch.Worst.Severity"></span>
            <span class="kind">@Kind(branch.Scope)</span>
            <span class="label">@branch.Label</span>
            <span class="mood">@mood</span>
            <span class="evidence">@(branch.IsLeaf ? branch.Worst.Evidence : $"{branch.Count} beneath")</span>
            <a class="tree-link" href="@MonitorLink(branch.Scope)">monitor</a>
        </div>
    };

    private static string MonitorLink(string scope) =>
        "/?scope=" + Uri.EscapeDataString(scope);

    // What a scope is, from where it sits: the record names cluster, node and
    // the three stages; beneath a stage sits the Location or Xmip Process and
    // beneath that the technology (ADR-0027; ADR-0028 for the playground).
    private static string Kind(string scope)
    {
        string[] parts = ScopeTree.Parts(scope);
        string stage = ScopeTree.Stage(scope);

        return parts.Length switch
        {
            1 => "cluster",
            2 => "node",
            3 when ScopeTree.Stages.Contains(parts[2]) => "stage",
            3 => "scope",
            4 when stage == "receive" => "receive location",
            4 when stage == "send" => "send location",
            4 when stage == "process" => "xmip process",
            _ => "technology",
        };
    }

    private static int StageOrder(string label)
    {
        int index = ScopeTree.Stages.ToList().IndexOf(label);
        return index < 0 ? ScopeTree.Stages.Count : index;
    }
}
