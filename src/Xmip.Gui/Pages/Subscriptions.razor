@page "/subscriptions"
@using Xmip.Abi.Operate
@using System.Globalization
@using Xmip.Gui.Surface
@inherits ClusterView
@inject RoleContext Role
@inject ProgramAudit Audited
@inject NavigationManager Nav

<PageTitle>Xmip — Subscriptions</PageTitle>

<RunLine Run="Surface.Run()" Cluster="@Cluster" Source="@Surface.Source" />

<ScopeFilterBox Id="filter-subscriptions" Pattern="@(Asking.Pattern ?? string.Empty)"
                PatternChanged="Patterned" Said="@PatternSaid" />

@* What picks a published Message up and opens a Journey (ADR-0013,
   amendment 2026-09-30; the owner, the same day: *a Subscription view, for
   all subscriptions per cluster, with pause and resume, but not remove. That
   is handled with the TOML configuration files*). Every Subscription the
   cluster's nodes route by — its configured name, the cluster and node, what
   it subscribes to and where it leads — with its state and what it picked up
   and holds. The drill is in the address, as every view's is: cluster, node,
   one Subscription, the pattern and the order are a link that reproduces the
   view. An Operator pauses and resumes; an Observer is shown the list and no
   act; nobody removes one here. Not an Event subscription, which hears what
   Xmip did: that is the Event subscriptions view. *@
<section class="drill subscriptions message-subscriptions">
    <DrillTrail Top="subscriptions" Location="@Asking.Location" Carried="@Carried"
                At="@(at => Link(Asking with { Location = at, Name = null }))"
                Opened="@(Asking.Name is { } name
                    ? ($"subscription {name}", Link(Asking))
                    : null)" />

    <ActNotes Refusal="@Refusal" Answer="@Answer" Counted="@Counted"
              Where="@ActSaid.Where(Surface, Listed.Orders,
                  "the node that routes by the Subscription",
                  "the node that routes by the Subscription")" />

    <p class="subs-configured">@SubscriptionOperation.Configured</p>

    @if (Detail is { } one)
    {
        <article class="subs-detail @MoodClass.Paused(one.Paused)">
            <h2>
                <span class="dot"></span>Subscription @one.Name on @SubscriptionQuery.NodeName(one)
                <small>@one.State</small>
            </h2>
            <dl class="subs-fields">
                <dt>subscription</dt><dd>@one.Name</dd>
                <dt>application</dt><dd>@one.Application</dd>
                <dt>cluster</dt><dd>@SubscriptionQuery.Cluster(one)</dd>
                <dt>node</dt><dd>@one.Node</dd>
                <dt>filter</dt><dd>@one.Filter</dd>
                <dt>leads to</dt><dd>@one.Destination</dd>
                <dt>state</dt><dd>@one.State</dd>
                @if (one.Paused)
                {
                    <dt>paused by</dt><dd class="subs-by">@one.By</dd>
                }
                <dt>picked up</dt><dd>@English.Figure(one.PickedUp)</dd>
                <dt>held</dt><dd>@English.Figure(one.Held)</dd>
                <dt>since</dt>
                <dd>
                    @one.Since.ToString("u", CultureInfo.InvariantCulture) ·
                    @English.Age(one.Since)
                </dd>
                <dt>file</dt><dd class="subs-file">@one.File</dd>
            </dl>
            <h3>configuration</h3>
            <pre class="subs-configuration">@one.Configuration</pre>
            @if (Role.MayOperate())
            {
                <div class="subs-acts">
                    <SubscriptionActs Subscription="one" Acted="Act" />
                    <span class="subs-act-said">
                        @(one.Paused ? SubscriptionActs.ResumeSaid : SubscriptionActs.PauseSaid)
                    </span>
                </div>
            }
        </article>
    }
    else
    {
        <NodeGroups TRecord="SubscriptionRecord" Records="Shown" Location="@Asking.Location"
                    NodeOf="s => s.Node" Paused="s => s.Paused" Noun="Subscription(s)"
                    At="@(node => Link(Asking with { Location = node, Name = null }))"
                    Figures="Figures" />

        <SubscriptionTable Records="Shown" Query="Asking" Carried="@Carried"
                           MayAct="Role.MayOperate()" Acted="Act" />
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "location")] public string? AskedLocation { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? AskedName { get; set; }
    [SupplyParameterFromQuery(Name = "pattern")] public string? AskedPattern { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? AskedSort { get; set; }
    [SupplyParameterFromQuery(Name = "order")] public string? AskedOrder { get; set; }

    private SubscriptionQuery Asking { get; set; } = new();

    private SubscriptionList Listed { get; set; } = SubscriptionList.Empty;

    private IReadOnlyList<SubscriptionRecord> Shown { get; set; } = [];

    // What the query was refused, read again with the view; and what the
    // last act said, which stays while the publications tick under it.
    private string Refusal { get; set; } = string.Empty;

    private string Answer { get; set; } = string.Empty;

    private SubscriptionRecord? Detail =>
        Asking.Name is not null && Shown is [var one] ? one : null;

    private string Counted =>
        $"{English.Figure((ulong)Shown.Count)} of "
        + $"{English.Figure((ulong)Listed.Subscriptions.Count)} Subscription(s) · "
        + $"{English.Figure((ulong)Shown.Count(s => s.Paused))} paused";

    private string PatternSaid =>
        !string.IsNullOrEmpty(Asking.Pattern)
            ? $"{English.Figure((ulong)Shown.Count)} Subscription(s) match {Asking.Pattern}"
            : string.Empty;

    protected override void Read()
    {
        // A view asked for a cluster and for no one in it stands at that
        // cluster: the scope its publisher publishes at, never a name.
        string? location = AskedLocation;
        if (location is null && Asked is not null)
        {
            location = Surface.Root();
        }

        Asking = new SubscriptionQuery
        {
            Location = location,
            Name = string.IsNullOrEmpty(AskedName) ? null : AskedName,
            Pattern = AskedPattern,
            Sort = AskedSort,
            Order = AskedOrder,
        };

        Listed = Surface.Subscriptions();
        Refusal = string.Empty;
        try
        {
            Shown = Asking.Apply(Listed.Subscriptions);
        }
        catch (ArgumentException refused)
        {
            Shown = [];
            Refusal = English.Refusal(refused);
        }
    }

    private string Link(SubscriptionQuery query) => ScopeLink.Subscriptions(query, Carried);

    private void Patterned(string pattern) =>
        Nav.NavigateTo(Link(Asking with { Pattern = pattern.Length == 0 ? null : pattern }));

    private static string Figures(IEnumerable<SubscriptionRecord> node) =>
        $"{English.Figure((ulong)node.Sum(s => (long)s.PickedUp))} picked up · "
        + $"{English.Figure((ulong)node.Sum(s => (long)s.Held))} held";

    // An act, by a role that may act: taken through the surface, recorded in
    // this host's audit with what came of it (ADR-0062) under the action
    // observe::Noun::Subscription gives it — subscription.<act> — and said.
    // An Observer is shown no act; one that reached here anyway is refused.
    private void Act((SubscriptionRecord Subscription, SubscriptionAct Act) asked)
    {
        (SubscriptionRecord subscription, SubscriptionAct act) = asked;
        string word = SubscriptionOperation.Word(act);

        if (!Role.MayOperate())
        {
            Answer = ActSaid.Refused(Role.Role, word, "a Subscription");
            Audited.Record(
                $"subscription.{word}", AuditPhase.Failure, AuditSeverity.Warning, Answer);
            return;
        }

        string who = ScopeOperation.Who(null);
        SubscriptionOperation done = Surface.Act(subscription, act, who);
        Audited.Record(
            $"subscription.{word}",
            done.Applied ? AuditPhase.Execute : AuditPhase.Failure,
            done.Applied ? AuditSeverity.Information : AuditSeverity.Warning,
            done.Result,
            new Dictionary<string, string>
            {
                ["node"] = subscription.Node,
                ["subscription"] = subscription.Name,
                ["application"] = subscription.Application,
                ["who"] = who,
            });
        Answer = ActSaid.Answer(done.Applied, done.Result);
        Read();
    }
}
