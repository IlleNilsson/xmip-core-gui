@page "/topology"
@using Xmip.Gui.Surface
@inherits ClusterView

<PageTitle>Xmip — Communication topology</PageTitle>

<RunLine Run="Surface.Run()" Cluster="@Cluster" Source="@Surface.Source" />

<ScopeFilterBox Id="filter-topology" Pattern="@Pattern" PatternChanged="Filtered"
                Said="@Filter.Said" />

<section class="topology-tools" aria-label="Topology controls">
    <button class="motion-toggle" @onclick="() => MotionPaused = !MotionPaused">
        @(MotionPaused ? "Resume movement" : "Pause movement")
    </button>
    <span class="topology-time">@English.Age(Snapshot.Observed)</span>
</section>

@* The way back up, each step an address (ADR-0052, amendment 2026-09-25):
   the drill is in the address, so the trail is links, not buttons a
   prerendered page cannot press. Infrastructure — every top-level thing —
   is a level of its own only where there is more than one of them. *@
<nav class="topology-trail" aria-label="Topology drill-down">
    @if (Roots.Count > 1)
    {
        <a href="@ScopeLink.Topology(Carried)">Infrastructure</a>
    }
    @foreach (TopologyNode node in Trail)
    {
        @if (Roots.Count > 1 || node != Trail[0])
        {
            <span>/</span>
        }
        <a href="@ScopeLink.TopologyAt(node.Id, Carried)"
           aria-current="@(node.Id == FocusId ? "page" : null)">@node.Label</a>
    }
</nav>

@if (Whole.Nodes.Count > 0 && Snapshot.Nodes.Count == 0)
{
    @* Drawn nothing because the filter kept nothing, which is not the same
       as a cluster that publishes no topology. *@
    <section class="topology-empty">
        <h1>Nothing matches @Filter.Pattern</h1>
        <p>@Filter.Said</p>
    </section>
}
else if (Snapshot.Nodes.Count == 0)
{
    <section class="topology-empty">
        <h1>No communication topology published</h1>
        <p>@Snapshot.Source</p>
        <p>
            Xmip draws what is configured and what is observed: a node run from
            configuration publishes its Locations and Processes, and a Playground
            cluster publishes its nodes, the stages each runs, their endpoints and
            the handoffs between them. Nothing is inferred from a socket.
        </p>
    </section>
}
else
{
    <section class="topology-layout">
        <TopologyGraph Snapshot="Snapshot"
                       FocusId="@FocusId"
                       MotionPaused="MotionPaused"
                       Drill="Drill"
                       OnSelectLink="@(link => SelectedLink = link)" />

        <TopologyInspector Snapshot="Snapshot"
                           Index="Index"
                           Run="Run"
                           Cluster="@Carried"
                           SelectedLink="SelectedLink"
                           FocusNode="FocusNode"
                           Drill="Drill" />
    </section>
}

@code {

    // What the surface published, and what the filter leaves of it. The
    // filter narrows the nodes; a link is drawn only where both of its ends
    // are still there, since a line to something hidden points at nothing.
    private TopologySnapshot Whole { get; set; } =
        TopologySnapshot.Empty("no topology read");

    private TopologySnapshot Snapshot { get; set; } =
        TopologySnapshot.Empty("no topology read");

    private string Pattern { get; set; } = string.Empty;

    private ScopeFilter Filter { get; set; } = ScopeFilter.None;

    /// <summary>The node the address opened, by its id; null where it
    /// opened none.</summary>
    [SupplyParameterFromQuery(Name = ScopeLink.Focus)]
    public string? Opened { get; set; }

    private void Filtered(string pattern)
    {
        Pattern = pattern;
        Read();
    }

    // The publication as its tree, read with the topology: what each node
    // declared it can do is a lookup in it, never a second parse of the file
    // (ADR-0014, amendment 2026-09-19: the model first).
    private ScopeIndex Index { get; set; } = ScopeIndex.Empty("nothing read yet");

    private RunHeader Run { get; set; } = RunHeader.None;

    private bool MotionPaused { get; set; }

    // The node whose components are drawn: the one the address opened, else
    // the one top-level thing there is. On 2026-09-25 the canvas opened on a
    // cluster alone, one box and no line, and the only way down was a click
    // on it and a button in the inspector, which nothing linked to (the
    // owner: *one can't drill down to nodes*). A cluster is opened at once,
    // so its nodes and the traffic between them are what the view shows.
    private string? FocusId { get; set; }

    private CommunicationLink? SelectedLink { get; set; }

    private IReadOnlyDictionary<string, TopologyNode> NodeById =>
        Snapshot.Nodes.ToDictionary(node => node.Id, StringComparer.Ordinal);

    private IReadOnlyList<TopologyNode> Roots =>
        [.. Snapshot.Nodes.Where(node => node.ParentId is null)];

    private TopologyNode? FocusNode =>
        FocusId is not null && NodeById.TryGetValue(FocusId, out TopologyNode? node)
            ? node
            : null;

    private IReadOnlyList<TopologyNode> Trail
    {
        get
        {
            List<TopologyNode> trail = [];
            TopologyNode? current = FocusNode;

            while (current is not null)
            {
                trail.Add(current);
                current = current.ParentId is not null
                    && NodeById.TryGetValue(current.ParentId, out TopologyNode? parent)
                        ? parent
                        : null;
            }

            trail.Reverse();
            return trail;
        }
    }

    // Where a node on the canvas leads: open, where something is beneath it;
    // a leaf ends at the view of its actual configuration (ADR-0052, ruling
    // 4 of 2026-09-14). Written once, for the canvas and the inspector.
    private string Drill(TopologyNode node) =>
        Snapshot.Nodes.Any(child => child.ParentId == node.Id)
            ? ScopeLink.TopologyAt(node.Id, Carried)
            : ScopeLink.Configuration(node.Scope, Carried);

    protected override void Read()
    {
        Whole = Surface.Topology();
        Index = Surface.Index();
        Filter = ScopeFilter.Over(Index, Pattern);
        Snapshot = Filter.Only(Whole);
        Run = Surface.Run();

        FocusId = Opened is not null && NodeById.ContainsKey(Opened)
            ? Opened
            : Roots.Count == 1 ? Roots[0].Id : null;

        if (SelectedLink is not null && !Snapshot.Links.Any(link => link.Id == SelectedLink.Id))
        {
            SelectedLink = null;
        }
    }
}
