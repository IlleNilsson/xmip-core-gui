<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The component library. ADR-0014: one library, two hosts — Blazor on the web,
    MAUI on the desktop — so what the desktop shows and what the web shows
    cannot disagree, because there is only one implementation to disagree with.

    The Razor and nothing else (ADR-0052): the screens, and the role that
    shapes what they offer. The surface they read, the scope tree, the
    rollup and the English are Xmip.Surface's, shared with the cli and the
    PowerShell module. Nothing here knows which host it is in. Target
    framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Gui</RootNamespace>
    <AssemblyName>Xmip.Gui</AssemblyName>

    <!-- Nothing here crosses the C ABI: Xmip.Abi holds the function pointers
         and raw structs for every surface, and Xmip.Surface the adapter over
         it. unsafe stays off, as Directory.Build.props has it. -->

    <!-- Razor-generated code carries no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- What every .NET surface shares, beside the binding in xmip-core-abi
         (ADR-0052 clause 1). A sibling in the estate, not vendored: the path
         is the estate's layout, four levels up. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-preview.7.*" />
  </ItemGroup>

</Project>
