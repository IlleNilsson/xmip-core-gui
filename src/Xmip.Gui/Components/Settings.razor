@using Xmip.Gui.Surface
@inject IPreferenceStore Preferences

@* The operator's own settings, behind the cog at the bar's end, Web and
   Desktop alike (ADR-0052, amendment 2026-11-25; the owner, the same day:
   "there should be a cog wheel, settings, where that and other settings can
   reside"). The cog is a button named Settings that opens the panel beneath
   it and closes it again; Escape closes it too, focus back on the cog, and so
   does a press anywhere outside it, which lands on its backdrop. Each setting
   is a row of the panel: its name, then its choices, the one in force
   pressed. The theme is the first: the system's, light or dark, kept by the
   host's store (IPreferenceStore, ThemeChoice). A view of one's own, no act
   on Xmip, so every role may. The cog is drawn inline, a line in the text's
   own color like every icon here, and painted by class. *@
<div class="settings" @onkeydown="Pressed">
    <button type="button" class="settings-cog" @ref="cog" title="Settings"
            aria-label="Settings" aria-expanded="@(open ? "true" : "false")"
            aria-controls="@(open ? Panel : null)" @onclick="() => open = !open">
        <svg class="icon settings-icon" viewBox="0 0 16 16" aria-hidden="true"
             focusable="false">
            <path d="@Cog" />
        </svg>
    </button>
    @if (open)
    {
        <div class="settings-backdrop" aria-hidden="true" @onclick="() => open = false"></div>
        <div class="settings-panel" id="@Panel" role="group" aria-labelledby="settings-title">
            <p class="settings-title" id="settings-title">Settings</p>
            <div class="settings-row" role="group" aria-labelledby="settings-theme">
                <span class="settings-name" id="settings-theme">Theme</span>
                <span class="settings-choices">
                    @foreach (Theme theme in Enum.GetValues<Theme>())
                    {
                        <button type="button" class="settings-choice"
                                aria-pressed="@(theme == Preferences.Theme ? "true" : "false")"
                                @onclick="() => Choose(theme)">@ThemeChoice.Name(theme)</button>
                    }
                </span>
            </div>
        </div>
    }
</div>

@code {
    // The panel's id, which the cog names as what it controls while open.
    private const string Panel = "settings";

    // A cog of six teeth about its hub, on the icons' grid of 16.
    private const string Cog =
        "M6.37 3.27L6.66 1.13H9.34L9.63 3.27A5 5 0 0 1 11.28 4.23L13.28 3.41"
        + "L14.62 5.72L12.91 7.05A5 5 0 0 1 12.91 8.95L14.62 10.28L13.28 12.59"
        + "L11.28 11.77A5 5 0 0 1 9.63 12.73L9.34 14.87H6.66L6.37 12.73"
        + "A5 5 0 0 1 4.72 11.77L2.72 12.59L1.38 10.28L3.09 8.95A5 5 0 0 1 3.09 7.05"
        + "L1.38 5.72L2.72 3.41L4.72 4.23A5 5 0 0 1 6.37 3.27Z"
        + "M10 8a2 2 0 1 1-4 0a2 2 0 1 1 4 0";

    private ElementReference cog;

    private bool open;

    // The theme in force is not kept again: the Web host's keeping loads
    // the page again.
    private void Choose(Theme theme)
    {
        if (theme != Preferences.Theme)
        {
            Preferences.Keep(theme);
        }
    }

    private async Task Pressed(KeyboardEventArgs key)
    {
        if (open && key.Key == "Escape")
        {
            open = false;
            await cog.FocusAsync();
        }
    }
}
