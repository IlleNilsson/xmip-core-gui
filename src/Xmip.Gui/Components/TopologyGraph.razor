@* The topology's canvas: every visible node placed on a ring — or, where
   Parties are drawn, in columns as the streams run, a Party that sends on the
   left and one delivered to on the right (ADR-0052, amendment 2026-09-29) — the
   communication between them drawn as a curve, and application movement as
   particles running along it. Animation represents application movement; the
   line remains the configured or observed relationship.

   What is drawn is what is configured and what is observed, together (the
   owner, 2026-09-18) — origin is never a filter here: a line configured and
   never used is dashed and says so on itself, a used one says its volume and
   rate (the owner, 2026-09-25). Every node is a link to its drill; a line is
   selected by a click, or from the keyboard — each is a button in the tab
   order, named for its ends, taken by Enter or Space — and the inspector's
   Traffic list selects the same lines as text. The legend names the
   patterns. *@
@using Xmip.Gui.Surface

<div class="topology-canvas">
    <svg viewBox="0 0 1000 620" role="img"
         aria-label="Configured and observed communication topology">
        <defs>
            <marker id="topology-arrow" markerWidth="8" markerHeight="8"
                    refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L8,4 L0,8 z" class="arrow-head" />
            </marker>
        </defs>

        @* The node the view is open at frames what is beneath it (ADR-0052,
           amendment 2026-09-25): the focus and its children, and nothing
           beside them. Until then the cluster box stood beside a node's own
           stages with every other node's traffic drawn into it. *@
        @if (Focus is not null)
        {
            <g class="topology-focus">
                <rect class="focus-frame" x="@Frame.Left" y="8" width="@Frame.Width"
                      height="604" rx="18" />
                <text class="focus-label" x="@(Frame.Left + 20)" y="34">
                    @Focus.Label <tspan class="focus-kind">@English.Name(Focus.Kind)</tspan>
                </text>
            </g>
        }

        @* Where traffic leaves the open node: one marker, outside the frame and
           said to be, rather than a box of whatever else there is. *@
        @if (Focus is not null && RenderedLinks.Any(Leaves))
        {
            <g class="topology-outside" transform="@Transform(Outside)">
                <title>Traffic between @Focus.Label and what lies outside it</title>
                <rect class="outside-body" x="-60" y="-34" width="120" height="68" rx="34" />
                <text class="node-label" text-anchor="middle" y="-3">outside</text>
                <text class="node-kind" text-anchor="middle" y="16">beyond @Focus.Label</text>
            </g>
        }

        @foreach (RenderedLink link in RenderedLinks)
        {
            <g class="@LinkClass(link.Link)">
                <path class="link-hit" d="@Curve(link)" tabindex="0" role="button"
                      aria-label="@Named(link.Link)"
                      @onclick="() => OnSelectLink.InvokeAsync(link.Link)"
                      @onkeydown="key => Pressed(key, link.Link)" />
                <path id="@SvgId(link.Link.Id)" class="link-line" d="@Curve(link)"
                      marker-end="url(#topology-arrow)" />
                @* What passes over it, on the line: the owner, 2026-09-25 — the
                   topology did not show configured traffic or its usage. A
                   link configured and never used says so here. *@
                <text class="link-figure" text-anchor="middle"
                      x="@Middle(link).X" y="@Middle(link).Y">@English.Traffic(link.Link)</text>
                @if (!MotionPaused)
                {
                    @for (int particle = 0; particle < Particles(link.Link); particle++)
                    {
                        bool reverse = Reverse(link.Link, particle);
                        <circle @key="particle" class="flow-particle"
                                r="@Radius(link.Link)">
                            <animateMotion path="@Motion(link, reverse)"
                                           dur="@Duration(link.Link)"
                                           begin="@($"{particle * -0.55}s")"
                                           repeatCount="indefinite" />
                        </circle>
                    }
                }
            </g>
        }

        @foreach (PlacedNode placed in PlacedNodes)
        {
            TopologyNode node = placed.Node;
            @* Every node is a link to its drill (the owner, 2026-09-25: one
               can't drill down to nodes): open where something is beneath
               it, else its configuration. *@
            <a class="topology-node-link" href="@Drill(node)">
            <g class="@NodeClass(node)"
               transform="@Transform(placed)"
               style="@NodeStyle(node)">
                <title>@Title(node)</title>
                <circle class="node-pulse" r="42" />
                <rect class="node-body" x="-64" y="-34" width="128" height="68" rx="12" />
                <circle class="node-state" cx="-47" cy="-17" r="6" />
                <text class="node-label" text-anchor="middle" y="-3">@node.Label</text>
                <text class="node-kind" text-anchor="middle" y="16">@English.Name(node.Kind)</text>
                <rect class="node-load-track" x="-48" y="24" width="96" height="4" rx="2" />
                <rect class="node-load" x="-48" y="24" width="@LoadWidth(node)"
                      height="4" rx="2" />
            </g>
            </a>
        }
    </svg>

    <div class="topology-legend" aria-label="Communication pattern legend">
        @foreach (CommunicationPattern pattern in Enum.GetValues<CommunicationPattern>())
        {
            <span class="@English.Word(pattern)"><i></i>@English.Name(pattern)</span>
        }
    </div>
</div>

@code {

    // A place on the canvas a line may end at: a drawn node, the open node's
    // frame, or the marker for what lies outside it.
    private record Spot(double X, double Y);

    private sealed record PlacedNode(TopologyNode Node, double X, double Y) : Spot(X, Y);

    private sealed record RenderedLink(
        CommunicationLink Link,
        Spot From,
        Spot To,
        int Index);

    // The open node's frame: wide, or narrowed where Parties are drawn so they
    // stand outside it — a Party is not part of what it sends to or is
    // delivered by (ADR-0052, amendment 2026-09-29).
    private sealed record Span(int Left, int Width);

    private Span Frame => HasParties ? new Span(170, 660) : new Span(150, 700);

    private bool HasParties => VisibleNodes.Any(node => node.Kind == TopologyNodeKind.Party);

    // The open node itself, where a line ends at it rather than at one of its
    // children: the top of its frame.
    private static readonly Spot FocusEdge = new(500D, 8D);

    // What lies outside the open node, to the right of its frame.
    private static readonly Spot Outside = new(920D, 300D);

    /// <summary>The configured and observed topology to draw.</summary>
    [Parameter]
    public TopologySnapshot Snapshot { get; set; } = TopologySnapshot.Empty("no topology read");

    /// <summary>The node whose components are open, or null for infrastructure.</summary>
    [Parameter]
    public string? FocusId { get; set; }

    /// <summary>The node the inspector shows, drawn as selected: a Party the
    /// operator opened, drawn among the things beside it.</summary>
    [Parameter]
    public string? SelectedId { get; set; }

    /// <summary>Whether the operator has paused the movement along the lines.</summary>
    [Parameter]
    public bool MotionPaused { get; set; }

    /// <summary>Where a node leads: its drill, written once by the page.</summary>
    [Parameter]
    public Func<TopologyNode, string> Drill { get; set; } = _ => string.Empty;

    /// <summary>Raised with the communication relationship the operator clicked.</summary>
    [Parameter]
    public EventCallback<CommunicationLink> OnSelectLink { get; set; }

    private IReadOnlyDictionary<string, TopologyNode> NodeById =>
        Snapshot.Nodes.ToDictionary(node => node.Id, StringComparer.Ordinal);

    private TopologyNode? Focus =>
        FocusId is not null && NodeById.TryGetValue(FocusId, out TopologyNode? node) ? node : null;

    // Open at a node: its children and nothing else. Open at nothing: every
    // top-level thing.
    private IReadOnlyList<TopologyNode> VisibleNodes
    {
        get
        {
            IEnumerable<TopologyNode> nodes = Focus is null
                ? Snapshot.Nodes.Where(node => node.ParentId is null)
                : Snapshot.Nodes.Where(node => node.ParentId == Focus.Id);

            return nodes.Where(Show)
                .DistinctBy(node => node.Id)
                .OrderBy(node => node.Label)
                .ToList();
        }
    }

    private IReadOnlyList<PlacedNode> PlacedNodes =>
        HasParties ? Flowing(VisibleNodes) : Ring(VisibleNodes);

    // Where Parties are drawn the canvas reads left to right, as the streams
    // run (the owner, 2026-09-29: *something is sending streams to a Xmip
    // Node; a Xmip Node sends streams to somethings*): a Party that sends,
    // left of the frame; the things inside it in columns, each after what
    // its links say feeds it; a Party delivered to, right of the frame. The
    // links decide, never a name.
    private IReadOnlyList<PlacedNode> Flowing(IReadOnlyList<TopologyNode> nodes)
    {
        HashSet<string> visible = [.. nodes.Select(node => node.Id)];
        List<(string From, string To)> edges = [];

        foreach (CommunicationLink link in Snapshot.Links.Where(Show))
        {
            if (Holder(link.From, visible) is { } from
                && Holder(link.To, visible) is { } to
                && from != to)
            {
                edges.Add((from, to));
            }
        }

        HashSet<string> parties = [
            .. nodes.Where(node => node.Kind == TopologyNodeKind.Party).Select(node => node.Id),
        ];
        List<(string From, string To)> within = [
            .. edges.Where(edge => !parties.Contains(edge.From) && !parties.Contains(edge.To)),
        ];
        Dictionary<string, int> column =
            nodes.ToDictionary(node => node.Id, _ => 0, StringComparer.Ordinal);

        // Longest path among the things inside, bounded by their number so a
        // cycle ends.
        for (int pass = 0; pass < nodes.Count; pass++)
        {
            foreach ((string from, string to) in within)
            {
                column[to] = Math.Max(column[to], Math.Min(column[from] + 1, nodes.Count));
            }
        }

        List<TopologyNode> inside = [.. nodes.Where(node => !parties.Contains(node.Id))];
        int columns = inside.Count == 0 ? 1 : inside.Max(node => column[node.Id]) + 1;
        List<PlacedNode> placed = [];

        foreach (IGrouping<int, TopologyNode> group in inside.GroupBy(node => column[node.Id]))
        {
            // Inset from the frame, so the figure on a Party's line has room.
            double x = Frame.Left + 30D + (Frame.Width - 60D) * (group.Key + 0.5D) / columns;
            placed.AddRange(Stacked(group.ToList(), x));
        }

        ILookup<bool, TopologyNode> sends = nodes
            .Where(node => parties.Contains(node.Id))
            .ToLookup(party => edges.Any(edge => edge.From == party.Id));
        placed.AddRange(Stacked([.. sends[true]], 78D));
        placed.AddRange(Stacked([.. sends[false]], 922D));

        return placed;
    }

    // One column of things, spread about the middle of the canvas.
    private static IEnumerable<PlacedNode> Stacked(IReadOnlyList<TopologyNode> nodes, double x)
    {
        double spacing = nodes.Count <= 1 ? 0D : Math.Min(140D, 480D / (nodes.Count - 1));

        return nodes.Select((node, index) =>
            new PlacedNode(node, x, 320D + (index - (nodes.Count - 1) / 2D) * spacing));
    }

    // The drawn thing that holds a node: itself, or its nearest ancestor that
    // is drawn; null where none is.
    private string? Holder(string id, HashSet<string> visible)
    {
        string? current = id;

        while (current is not null && !visible.Contains(current))
        {
            current = NodeById.TryGetValue(current, out TopologyNode? node) ? node.ParentId : null;
        }

        return current;
    }

    private static IReadOnlyList<PlacedNode> Ring(IReadOnlyList<TopologyNode> nodes)
    {
        List<PlacedNode> placed = [];

        for (int index = 0; index < nodes.Count; index++)
        {
            double angle = -Math.PI / 2D + (2D * Math.PI * index / Math.Max(nodes.Count, 1));
            double radius = nodes.Count <= 2 ? 185D : 235D;
            placed.Add(new PlacedNode(
                nodes[index],
                500D + Math.Cos(angle) * radius,
                300D + Math.Sin(angle) * radius));
        }

        return placed;
    }

    private IReadOnlyList<RenderedLink> RenderedLinks
    {
        get
        {
            IReadOnlyList<PlacedNode> placed = PlacedNodes;
            Dictionary<string, PlacedNode> positions =
                placed.ToDictionary(item => item.Node.Id, StringComparer.Ordinal);
            List<RenderedLink> links = [];

            foreach (CommunicationLink link in Snapshot.Links.Where(Show))
            {
                Spot? from = Representative(link.From, positions);
                Spot? to = Representative(link.To, positions);

                // Nothing to draw within one drawn thing, and nothing that
                // runs entirely outside the open node.
                if (from is null || to is null || from == to)
                {
                    continue;
                }

                links.Add(new RenderedLink(link, from, to, links.Count));
            }

            return links;
        }
    }

    private static bool Leaves(RenderedLink link) => link.From == Outside || link.To == Outside;

    // The topology is always what is configured and what is observed,
    // together: the owner, 2026-09-18, on a switch between the two that the
    // page carried — no need for it. Origin is still said on what is
    // selected; it is never a filter.
    private static bool Show(TopologyNode node) => node is not null;

    private static bool Show(CommunicationLink link) => link is not null;

    // A link between things that are closed is drawn between the drawn
    // ancestors that hold them: node to node while the stages are closed.
    // Open at a node, an end that is the node itself meets its frame, and an
    // end that lies outside it meets the outside marker.
    private Spot? Representative(
        string nodeId,
        IReadOnlyDictionary<string, PlacedNode> positions)
    {
        string? current = nodeId;

        while (current is not null)
        {
            if (positions.TryGetValue(current, out PlacedNode? placed))
            {
                return placed;
            }

            if (current == Focus?.Id)
            {
                return FocusEdge;
            }

            current = NodeById.TryGetValue(current, out TopologyNode? node)
                ? node.ParentId
                : null;
        }

        return Focus is null ? null : Outside;
    }

    // A line as a reader of the screen hears it: what it is, between what,
    // and what passes over it.
    private string Named(CommunicationLink link) =>
        $"Select {English.Name(link.Pattern)} from {Label(link.From)} to {Label(link.To)}: "
        + English.Traffic(link);

    private string Label(string id) =>
        NodeById.TryGetValue(id, out TopologyNode? node) ? node.Label : id;

    private Task Pressed(KeyboardEventArgs key, CommunicationLink link) =>
        key.Key is "Enter" or " " ? OnSelectLink.InvokeAsync(link) : Task.CompletedTask;

    private static string LinkClass(CommunicationLink link) =>
        $"topology-link {MoodClass.Of(link.State)} {English.Word(link.Origin)} {English.Word(link.Pattern)}";

    private string NodeClass(TopologyNode node) =>
        $"topology-node {English.Word(node.Kind)} {MoodClass.Of(node.State)} {English.Word(node.Origin)}"
        + (node.Activity > 0.05 ? " active" : "")
        + (node.Id == SelectedId ? " selected" : "");

    private static string Title(TopologyNode node) =>
        $"{node.Label}: {English.Name(node.Kind)}, {English.Mood(node.State)}. {node.Evidence}";

    private static string Transform(Spot node) =>
        FormattableString.Invariant($"translate({node.X:0.##} {node.Y:0.##})");

    private static string NodeStyle(TopologyNode node)
    {
        double activity = Math.Clamp(node.Activity, 0D, 1D);
        double load = Math.Clamp(node.Load, 0D, 1D);

        return FormattableString.Invariant($"--activity:{activity:0.###};--load:{load:0.###}");
    }

    private static double LoadWidth(TopologyNode node) =>
        96D * Math.Clamp(node.Load, 0D, 1D);

    private static string SvgId(string id)
    {
        return "topology-" + string.Concat(id.Select(character =>
            char.IsLetterOrDigit(character) ? character : '-'));
    }

    private static int Stable(string value) =>
        value.Aggregate(17, (hash, character) => unchecked(hash * 31 + character));

    // The curve's control point: bent off the straight line by a stable
    // amount per link, so two links between one pair do not overlap.
    private static (double X, double Y) Control(RenderedLink link)
    {
        double dx = link.To.X - link.From.X;
        double dy = link.To.Y - link.From.Y;
        double length = Math.Max(Math.Sqrt(dx * dx + dy * dy), 1D);
        uint stable = unchecked((uint)Stable(link.Link.Id));
        double bend = ((stable % 5U) - 2D) * 14D;

        return (
            (link.From.X + link.To.X) / 2D - dy / length * bend,
            (link.From.Y + link.To.Y) / 2D + dx / length * bend);
    }

    private static string Curve(RenderedLink link)
    {
        (double controlX, double controlY) = Control(link);

        return FormattableString.Invariant(
                $"M {link.From.X:0.##} {link.From.Y:0.##} Q {controlX:0.##} {controlY:0.##} ")
            + FormattableString.Invariant($"{link.To.X:0.##} {link.To.Y:0.##}");
    }

    // Where the curve is halfway, for the figure written on it: a quadratic
    // curve at one half is a quarter of each end and half its control point.
    private static (string X, string Y) Middle(RenderedLink link)
    {
        (double controlX, double controlY) = Control(link);
        double x = (link.From.X + link.To.X) / 4D + controlX / 2D;
        double y = (link.From.Y + link.To.Y) / 4D + controlY / 2D - 6D;

        return (
            x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
    }

    private static string Motion(RenderedLink link, bool reverse) =>
        reverse
            ? FormattableString.Invariant(
                $"M {link.To.X:0.##} {link.To.Y:0.##} L {link.From.X:0.##} {link.From.Y:0.##}")
            : FormattableString.Invariant(
                $"M {link.From.X:0.##} {link.From.Y:0.##} L {link.To.X:0.##} {link.To.Y:0.##}");

    private static int Radius(CommunicationLink link) =>
        link.Pattern == CommunicationPattern.Streaming ? 4 : 5;

    private static int Particles(CommunicationLink link) =>
        link.Pattern switch
        {
            CommunicationPattern.Streaming => 4,
            CommunicationPattern.Session => 2,
            CommunicationPattern.RequestResponse => 2,
            CommunicationPattern.Retry => (int)Math.Clamp(link.Attempts, 1U, 4U),
            _ => 1,
        };

    private static bool Reverse(CommunicationLink link, int particle) =>
        link.Pattern is CommunicationPattern.RequestResponse or CommunicationPattern.Session
        && particle % 2 == 1;

    private static string Duration(CommunicationLink link)
    {
        double seconds = link.Pattern == CommunicationPattern.Streaming
            ? 1.1D
            : Math.Clamp(3.2D - Math.Log10(link.Rate + 1D), 0.8D, 3.2D);

        return FormattableString.Invariant($"{seconds:0.##}s");
    }
}
