@using Xmip.Abi.Operate

@* A Report's kind: its icon (ADR-0072, amendment 2026-11-12; the owner, the
   same day: "Report icon and a Probing report icon, not the text"). A page
   for a Report, which presents data that already exists; the same page under
   a magnifying glass for a Probing report, which presents what a Quest
   probes first. The kind's name is the icon's accessible name and its hover
   text, with its meaning; only the legend shows the name beside the icon,
   since a legend is where an icon is read. The kind is the runtime's, from
   what an entry holds and never from its name, and so are its word, which
   styles it, its name and its meaning; this picks only the glyph. Plain,
   generic and inline, drawn in the text's own color — neither the brand nor
   a mood — and painted by class, so the content security policy's rule
   against an inline style holds. *@
<span class="report-kind @Words.Word" title="@($"{Words.Name}: {Words.Meaning}")">
    @if (Glyph is { } glyph)
    {
        <svg class="report-icon @glyph.Name" viewBox="0 0 16 16" role="img"
             aria-label="@Words.Name" focusable="false">
            <path d="@glyph.Path" />
        </svg>
    }
    @if (Named || Glyph is null)
    {
        @Words.Name
    }
</span>

@code {
    /// <summary>The kind and the runtime's words for it: a legend's, or an
    /// entry's own (<see cref="ReportEntry.Words"/>).</summary>
    [Parameter, EditorRequired]
    public ReportKindWords Words { get; set; } = default!;

    /// <summary>Whether the name is shown beside the icon: the legend's,
    /// and nowhere else.</summary>
    [Parameter]
    public bool Named { get; set; }

    // The glyph for each kind, by the kind's number in the header: the one
    // choice this component makes. A kind with no glyph is shown by its name.
    private (string Name, string Path)? Glyph => Words.Kind switch
    {
        ReportKind.ExistingData => ("page",
            "M3.5 1.5h6l3 3v10h-9z M9.5 1.5v3h3 M5.5 7.5h5 M5.5 10h5 M5.5 12.5h3"),
        ReportKind.Quest => ("probing",
            "M7.5 14.5h-5v-13h6l3 3v3 M8.5 1.5v3h3 M4.5 6.5h4 M4.5 9h2"
                + " M13.5 11a2.5 2.5 0 1 1-5 0a2.5 2.5 0 1 1 5 0 M12.8 12.8l2 2"),
        _ => null,
    };
}
