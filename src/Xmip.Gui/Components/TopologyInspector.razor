@* What the operator has selected in the topology, said in full: a node, a
   communication relationship, or — until something is selected — what the
   canvas is showing and how to read it. Every level drills to the same scope
   in the other two views (ADR-0052, ruling 4), and a node with components
   beneath it can be opened from here. *@
@using Xmip.Gui.Surface
@using static Xmip.Gui.Surface.TopologyWords

<aside class="topology-inspector">
    @if (SelectedNode is not null)
    {
        <h2>@SelectedNode.Label</h2>
        <dl>
            <dt>Kind</dt><dd>@Kind(SelectedNode.Kind)</dd>
            <dt>State</dt><dd class="@Mood(SelectedNode.State)">@Mood(SelectedNode.State)</dd>
            <dt>Evidence</dt><dd>@Value(SelectedNode.Evidence)</dd>
            @* What the node declared it can do (ADR-0056), where an
               operator has drilled to the node itself. One row: the
               stages and the route, with the publisher's own words —
               including the kinds it does not model — on the row. *@
            @if (Declared(SelectedNode) is { Said: true } capability)
            {
                <dt>Capability</dt>
                <dd class="capability" title="@capability.Evidence">
                    @capability.Line()
                    <small>@capability.Origin</small>
                </dd>
            }
            <dt>Origin</dt><dd>@OriginName(SelectedNode.Origin)</dd>
            <dt>Load</dt><dd>@Percent(SelectedNode.Load)</dd>
            <dt>Activity</dt><dd>@Percent(SelectedNode.Activity)</dd>
            <dt>Scope</dt><dd class="mono">@Value(SelectedNode.Scope)</dd>
        </dl>
        @Drill(SelectedNode.Scope)
        @if (HasChildren(SelectedNode.Id))
        {
            <button class="inspect-action"
                    @onclick="() => OnOpen.InvokeAsync(SelectedNode)">Open components</button>
        }
    }
    else if (SelectedLink is not null)
    {
        <h2>@PatternName(SelectedLink.Pattern)</h2>
        <dl>
            <dt>From</dt><dd>@NodeLabel(SelectedLink.From)</dd>
            <dt>To</dt><dd>@NodeLabel(SelectedLink.To)</dd>
            <dt>Protocol</dt><dd>@Value(SelectedLink.Protocol)</dd>
            <dt>State</dt><dd class="@Mood(SelectedLink.State)">@Mood(SelectedLink.State)</dd>
            <dt>Origin</dt><dd>@OriginName(SelectedLink.Origin)</dd>
            <dt>Volume</dt><dd>@English.Figure(SelectedLink.Volume)</dd>
            <dt>Rate</dt><dd>@($"{SelectedLink.Rate:0.##}/s")</dd>
            <dt>Latency</dt><dd>@($"{SelectedLink.LatencyMilliseconds:0.##} ms")</dd>
            <dt>Progress</dt><dd>@Percent(SelectedLink.Progress)</dd>
            <dt>Attempts</dt><dd>@SelectedLink.Attempts</dd>
            <dt>Evidence</dt><dd>@Value(SelectedLink.Evidence)</dd>
        </dl>
        @Drill(ScopeOf(SelectedLink.From))
    }
    else
    {
        <h2>@(FocusNode?.Label ?? "Infrastructure")</h2>
        <p>
            Select a node or communication relationship. Open a node to reveal
            the components beneath it.
        </p>
        <p>
            Animation represents application movement. The line remains the
            configured or observed relationship.
        </p>
    }
</aside>

@code {

    /// <summary>The topology the selection was made in.</summary>
    [Parameter]
    public TopologySnapshot Snapshot { get; set; } = TopologySnapshot.Empty("no topology read");

    /// <summary>The publication as its tree, where a node's declaration is read.</summary>
    [Parameter]
    public ScopeIndex Index { get; set; } = ScopeIndex.Empty("nothing read yet");

    /// <summary>What the run was started with, for a node that published none.</summary>
    [Parameter]
    public RunHeader Run { get; set; } = RunHeader.None;

    /// <summary>The selected node, or null.</summary>
    [Parameter]
    public TopologyNode? SelectedNode { get; set; }

    /// <summary>The selected communication relationship, or null.</summary>
    [Parameter]
    public CommunicationLink? SelectedLink { get; set; }

    /// <summary>The node whose components are open, named when nothing is selected.</summary>
    [Parameter]
    public TopologyNode? FocusNode { get; set; }

    /// <summary>Raised with the node whose components the operator opened.</summary>
    [Parameter]
    public EventCallback<TopologyNode> OnOpen { get; set; }

    /// <summary>The cluster the links out of here carry, where the host holds
    /// more than one (ADR-0052, amendment 2026-09-20); null where it holds
    /// one, and then the links read as they always did.</summary>
    [Parameter]
    public string? Cluster { get; set; }

    private IReadOnlyDictionary<string, TopologyNode> NodeById =>
        Snapshot.Nodes.ToDictionary(node => node.Id, StringComparer.Ordinal);

    // A node's own declaration wins; a node that published none falls back to
    // what the run started it with, and NodeCapability.Origin says which.
    // Only a node declares — a stage or an endpoint is not something that can.
    private NodeCapability Declared(TopologyNode node)
    {
        if (node.Kind != TopologyNodeKind.Node)
        {
            return NodeCapability.None;
        }

        NodeCapability published = Index.Capability(node.Label);

        return published.Said ? published : Run.Capability(node.Label);
    }

    // From what is selected to the same scope in the other two views: the
    // topology is one of three points to drill from, and a node or a link
    // ends at the actual configuration (ADR-0052, ruling 4).
    private RenderFragment Drill(string? scope) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(scope))
        {
            <p class="inspect-links">
                <a href="@ScopeLink.Configuration(scope, Cluster)">configuration</a>
                <a href="@ScopeLink.Monitor(scope, Cluster)">monitor</a>
            </p>
        }
    };

    private string? ScopeOf(string nodeId) =>
        Snapshot.Nodes.FirstOrDefault(node => node.Id == nodeId)?.Scope;

    private bool HasChildren(string id) => Snapshot.Nodes.Any(node => node.ParentId == id);

    private string NodeLabel(string id) =>
        NodeById.TryGetValue(id, out TopologyNode? node) ? node.Label : id;
}
