@using Xmip.Abi.Operate
@using Xmip.Gui.Surface

@* The Subscriptions view's rows (ADR-0013, amendment 2026-09-30): a bounded
   list of plain rows — never a Virtualize, which prerendered an empty spacer
   the height of every row (Pages/Cluster.razor) — and the rest counted. The
   head orders by a column (SortHead), by SubscriptionQuery's order, the one
   every surface uses. A row's name opens that Subscription; its cluster and
   node are where the drill stands next. Paused is a mood (ADR-0041), painted
   as the Monitor paints it and said in words beside the dot. A role that may
   operate is offered Pause or Resume; nothing removes a Subscription here —
   it is removed in the TOML configuration that adds it. *@
<section class="subs-records message-subs" aria-label="Subscriptions">
    @if (Records.Count == 0)
    {
        <p class="empty">No Subscription here matches.</p>
    }
    else
    {
        <SortHead Columns="Columns" By="@(Query.Sort ?? SubscriptionQuery.Columns[0])"
                  Descending="Query.Descending" Link="Sort" MayAct="MayAct" />
        @foreach (SubscriptionRecord entry in Records.Take(Shown))
        {
            <div class="subs-row @MoodClass.Paused(entry.Paused)"
                 role="row">
                <span class="dot" title="@entry.State"></span>
                <a class="subs-name" title="@($"drawn in {entry.Application}")"
                   href="@Link(Query with { Location = entry.Node, Name = entry.Name })">
                    @entry.Name
                </a>
                <a class="subs-cluster"
                   href="@Link(Query with { Location = ClusterOf(entry), Name = null })">
                    @SubscriptionQuery.Cluster(entry)
                </a>
                <a class="subs-node"
                   href="@Link(Query with { Location = entry.Node, Name = null })">
                    @SubscriptionQuery.NodeName(entry)
                </a>
                <span class="subs-filter" title="@entry.Filter">@entry.Filter</span>
                <span class="subs-destination" title="@entry.Destination">@entry.Destination</span>
                <span class="subs-state">@entry.State</span>
                <span class="subs-figure">@English.Figure(entry.PickedUp)</span>
                <span class="subs-figure">@English.Figure(entry.Held)</span>
                <span class="subs-since">@English.Age(entry.Since)</span>
                <span class="subs-acts">
                    @if (MayAct)
                    {
                        <SubscriptionActs Subscription="entry" Acted="Acted" />
                    }
                </span>
            </div>
        }
        @if (Records.Count > Shown)
        {
            <p class="empty">
                @English.Figure((ulong)(Records.Count - Shown)) more below these @Shown; the
                filter narrows to them.
            </p>
        }
    }
</section>

@code {
    /// <summary>How many rows are drawn.</summary>
    public const int Shown = 200;

    /// <summary>The Subscriptions, already selected and ordered.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SubscriptionRecord> Records { get; set; } = [];

    /// <summary>What the view asked for them.</summary>
    [Parameter, EditorRequired]
    public SubscriptionQuery Query { get; set; } = new();

    /// <summary>The cluster a link carries, as every view's links do.</summary>
    [Parameter]
    public string? Carried { get; set; }

    /// <summary>Whether the role at the keyboard may act (ADR-0009).</summary>
    [Parameter]
    public bool MayAct { get; set; }

    /// <summary>Raised with a Subscription and the act taken on it.</summary>
    [Parameter]
    public EventCallback<(SubscriptionRecord, SubscriptionAct)> Acted { get; set; }

    // The columns shown and what each is headed, by SubscriptionQuery's words.
    private static readonly (string Column, string Heading)[] Columns =
    [
        ("subscription", "subscription"), ("cluster", "cluster"), ("node", "node"),
        ("filter", "filter"), ("destination", "leads to"), ("state", "state"),
        ("picked-up", "picked up"), ("held", "held"), ("since", "since"),
    ];

    private string Link(SubscriptionQuery query) => ScopeLink.Subscriptions(query, Carried);

    private string Sort(string column, string? order) =>
        Link(Query with { Sort = column, Order = order });

    private static string ClusterOf(SubscriptionRecord entry) =>
        ScopeTree.Join([SubscriptionQuery.Cluster(entry)]);
}
