@using Microsoft.AspNetCore.Components.Routing
@using Xmip.Gui.Surface
@inject RoleContext Role

@* The bar every host shows, once: the nine views this library draws, most
   wanted first (ADR-0052, amendment 2026-11-12; the owner, the same day:
   "Monitor is the most desired view") — the Monitor; the Dead Message
   Queue, the one view where something waits on a person; the
   Subscriptions beside it, where a Message no Subscription took is
   usually fixed; the Topology; the Configuration; the Event
   subscriptions; the Audit; the Reports after it, every Report in one
   list, for every role (ADR-0072, amendment 2026-11-10); and the Secrets
   last, the least visited and the most sensitive — what the host adds
   after them, and who is at the keyboard with the role
   they hold — proven, and assigned, not chosen here (ADR-0009, amendment
   2026-10-06), by one rule for both hosts and the hub (RoleAssignment),
   described in one set of words (Roles.Describe). The web host adds nothing; the desktop adds
   Configure for a role that may configure. Until 2026-09-27 each host wrote
   its own bar and worded the roles its own way. *@
<nav class="topnav">
    <img class="logo" src="_content/Xmip.Gui/xmip-logo.png" alt="Xmip" />
    <NavLink class="topnav-link" href="/" Match="NavLinkMatch.All">Monitor</NavLink>
    <NavLink class="topnav-link" href="/dead-messages">Dead Message Queue</NavLink>
    <NavLink class="topnav-link" href="/subscriptions">Subscriptions</NavLink>
    <NavLink class="topnav-link" href="/topology">Topology</NavLink>
    <NavLink class="topnav-link" href="/configuration">Configuration</NavLink>
    <NavLink class="topnav-link" href="/event-subscriptions">Event subscriptions</NavLink>
    <NavLink class="topnav-link" href="/audit">Audit</NavLink>
    <NavLink class="topnav-link" href="/reports">Reports</NavLink>
    <NavLink class="topnav-link" href="/secrets">Secrets</NavLink>
    @ChildContent
    <div class="role">
        <span class="role-label">role</span>
        <span class="role-pick active" title="@Role.Role.Describe()">@Role.Role</span>
        <span class="role-who">@(Role.Who ?? "nobody proven")</span>
    </div>
</nav>

@code {
    /// <summary>What the host adds after the nine views.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
