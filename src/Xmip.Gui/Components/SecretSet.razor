@using Microsoft.AspNetCore.Components.Forms

@* Set a secret, or replace one of the same name, which keeps its
   identifier (ADR-0019, amendment 2026-10-29): its name, its kind and its
   value, typed into a password field or read from a chosen file — a key's or
   a certificate's PEM. The value is never echoed: the field is a password
   field, and it and the chosen file are let go before the act is raised, so
   nothing here holds the value once it is handed on; nor is it ever audited,
   which records the name. The name and the kind stay for the next. Only a
   role that may operate is offered this; the act is gated by the page. *@
<div class="secret-set" role="group" aria-label="Set a secret">
    <h3>set or replace a secret</h3>
    <label>
        <span>name</span>
        <input class="secret-set-name" @bind="name" @bind:event="oninput"
               autocomplete="off" spellcheck="false" />
    </label>
    <label>
        <span>kind</span>
        <select class="secret-set-kind" @bind="kind">
            @foreach (string word in SecretRecord.Kinds)
            {
                <option value="@word">@word</option>
            }
        </select>
    </label>
    <label>
        <span>value from</span>
        <select class="secret-set-from" @bind="from">
            <option value="@Typed">a password field</option>
            <option value="@Filed">a file</option>
        </select>
    </label>
    @if (from == Filed)
    {
        <label>
            <span>file</span>
            <InputFile @key="chosenTimes" class="secret-set-file" OnChange="Chosen" />
        </label>
    }
    else
    {
        <label>
            <span>value</span>
            <input class="secret-set-value" type="password" @bind="typed"
                   @bind:event="oninput" autocomplete="new-password" />
        </label>
    }
    <button class="act" type="button" disabled="@(!Ready)" title="@SetSaid"
            @onclick="SetAsync">
        Set
    </button>
    <span class="subs-act-said">@SetSaid</span>
    @if (Unread.Length > 0)
    {
        <p class="subs-said refused">@Unread</p>
    }
</div>

@code {
    /// <summary>What setting does, in the words the view says it.</summary>
    public const string SetSaid =
        "Kept sealed by the node, replacing one of the same name; a Location naming it "
        + "presents it as it next connects. It is never shown again.";

    /// <summary>The largest file read as a value: a PEM chain is a few
    /// kilobytes.</summary>
    public const long Largest = 1024 * 1024;

    private const string Typed = "typed";
    private const string Filed = "file";

    private string name = string.Empty;
    private string kind = SecretRecord.Kinds[0];
    private string from = Typed;
    private string typed = string.Empty;
    private IBrowserFile? file;
    private int chosenTimes;

    /// <summary>Raised with the secret's name, its kind and its value.</summary>
    [Parameter]
    public EventCallback<(string Name, string Kind, string Value)> Acted { get; set; }

    private string Unread { get; set; } = string.Empty;

    private bool Ready =>
        name.Trim().Length > 0 && (from == Filed ? file is not null : typed.Length > 0);

    private void Chosen(InputFileChangeEventArgs chosen)
    {
        file = chosen.File;
        Unread = string.Empty;
    }

    private async Task SetAsync()
    {
        if (!Ready)
        {
            return;
        }

        string value;
        Unread = string.Empty;

        if (from == Filed)
        {
            try
            {
                await using Stream stream = file!.OpenReadStream(Largest);
                using StreamReader reader = new(stream);
                value = await reader.ReadToEndAsync();
            }
            catch (IOException unread)
            {
                Unread = $"FAILED: the file could not be read: {unread.Message}";
                Forget();
                return;
            }
        }
        else
        {
            value = typed;
        }

        // Let go before handing on: nothing here holds the value through the
        // act or after it.
        Forget();
        await Acted.InvokeAsync((name.Trim(), kind, value));
    }

    // The value typed and the file chosen, gone; a new file input replaces
    // the old, so the name of the file chosen is not left on it.
    private void Forget()
    {
        typed = string.Empty;
        file = null;
        chosenTimes++;
    }
}
