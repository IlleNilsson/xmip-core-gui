@using Xmip.Abi.Operate
@using Xmip.Gui.Surface
@inject RoleContext Role
@inject ProgramAudit Audited

@* Every Message that failed at a Send Port, at the Port's own record, with
   Retry and Dismiss on each (runtime-model.md section 13; ADR-0013): the
   list the surface reads (IOperatorSurface.FailedMessages) — from Xmip
   Storage a page at a time where the node runs in this process, the oldest
   hundred its publication carries otherwise — each Message with its place
   and why, and how many wait at the Port. A page the node read empty with a
   next place is followed until it finds failed Messages or the queue's end:
   the place, not the Messages, says whether more remain. A surface that
   answered is taken at its word, an empty answer included; only a surface
   that cannot list failed Messages falls back to the one Message the Port's
   evidence names (MessageOperation.FailedIn), and not where the evidence
   says none wait in the queue now (MessageOperation.FailingIn). A surface
   that asked and was not answered — Xmip Storage did not answer — says so
   in its words and offers nothing. An Operator
   retries at once, and dismisses only once the view has named the Message
   and said it leaves the queue for good; an Observer is shown the Messages
   and no act. What the last act came to stays beside the list while the
   publications tick under it. *@
@if (Shown.Count > 0 || Next is not null || Answer.Length > 0 || Unanswered.Length > 0)
{
    <div class="message-acts">
        @if (Unanswered.Length > 0)
        {
            <span class="subs-said refused message-unanswered">@Unanswered</span>
        }
        @if (Shown.Count > 0)
        {
            <span class="subs-act-said">@Counted</span>
        }
        @if (Blocked)
        {
            <span class="subs-act-said message-blocked">@BlockedSaid</span>
        }
        <ul class="message-list">
            @foreach (FailedMessageRecord failed in Shown)
            {
                <li class="message-failed" data-journey="@failed.Journey">
                    @if (Role.MayOperate())
                    {
                        <button class="act" title="@RetrySaid"
                                @onclick="() => Act(failed.Journey, MessageAct.Retry)">
                            Retry
                        </button>
                        <button class="act" title="@DismissSaid"
                                @onclick="() => Confirming = failed.Journey">
                            Dismiss
                        </button>
                    }
                    <span class="subs-act-said">the Message of the Journey @failed.Journey</span>
                    @if (failed.Reason.Length > 0)
                    {
                        <span class="subs-act-said"> — @failed.Reason</span>
                    }
                    @if (Confirming == failed.Journey && Role.MayOperate())
                    {
                        <span class="message-confirm" role="alertdialog"
                              aria-label="Dismiss the Message of the Journey @failed.Journey">
                            <span class="subs-act-said">@Asked(failed.Journey)</span>
                            <button class="act dismiss-confirm"
                                    @onclick="() => Act(failed.Journey, MessageAct.Dismiss)">
                                Dismiss for good
                            </button>
                            <button class="act dismiss-keep" @onclick="() => Confirming = null">
                                Keep it
                            </button>
                        </span>
                    }
                </li>
            }
        </ul>
        @if (Next is { } next)
        {
            <button class="act more" @onclick="() => Page(next)">More</button>
        }
        @if (Answer.Length > 0)
        {
            <span class="subs-said @(Answer.StartsWith("REFUSED", StringComparison.Ordinal)
                ? "refused" : "")">@Answer</span>
        }
    </div>
}

@code {
    /// <summary>What a Retry does, in the words the view says it.</summary>
    public const string RetrySaid =
        "Sent again, its tries begun anew, from the end of its Send Port's queue — or from its "
        + "place, where it blocks its sequence.";

    /// <summary>What a blocked key is, in the words the view says it.</summary>
    public const string BlockedSaid =
        "BLOCKED: every Message of its key waits behind the first that failed until it is "
        + "retried or dismissed.";

    /// <summary>What a Dismiss does, in the words the view says it.</summary>
    public const string DismissSaid =
        "Given up: written Dismissed, its history, Message and Stream kept, and taken out of "
        + "its Send Port's queue.";

    /// <summary>The surface the view reads and acts through.</summary>
    [Parameter, EditorRequired]
    public IOperatorSurface Surface { get; set; } = default!;

    /// <summary>The Send Port's own record: its scope is where the Messages
    /// are listed, its evidence names the last that failed.</summary>
    [Parameter, EditorRequired]
    public HealthRecord Record { get; set; } = default!;

    /// <summary>Raised once an act was taken, for the view to read again.</summary>
    [Parameter]
    public EventCallback Acted { get; set; }

    private string Answer { get; set; } = string.Empty;

    // What the surface was told where it asked for the failed Messages and
    // Xmip Storage did not answer; empty otherwise.
    private string Unanswered { get; set; } = string.Empty;

    private IReadOnlyList<FailedMessageRecord> Shown { get; set; } = [];

    private ulong Count { get; set; }

    // Whether a Message shown blocks its sequence: said loud (ADR-0024,
    // amendment 2026-10-27).
    private bool Blocked { get; set; }

    private ulong? Next { get; set; }

    // Where the page shown starts in the Port's queue.
    private ulong From { get; set; }

    // The scope the paging is of: a Port changed under the view starts again
    // from the queue's head.
    private string? Paged { get; set; }

    // The Message whose Dismiss waits for the Operator to confirm it.
    private string? Confirming { get; set; }

    private string Counted => Count == 1
        ? "1 Message failed in its Send Port's queue"
        : $"{Count} Messages failed in its Send Port's queue";

    /// <summary>What the view asks before it dismisses
    /// <paramref name="journey"/>.</summary>
    public static string Asked(string journey)
    {
        return $"Dismiss the Message of the Journey {journey}? It leaves its Send Port's queue "
            + "for good: written Dismissed, never sent again.";
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!string.Equals(Paged, Record.Scope, StringComparison.Ordinal))
        {
            Paged = Record.Scope;
            From = 0;
            Confirming = null;
            Answer = string.Empty;
        }

        Read();
    }

    // The page from From of the Messages that failed at the Port's scope,
    // following each next place past stretches that held none; the one the
    // evidence names only where the surface cannot list them.
    private void Read()
    {
        FailedMessageList failed = Surface.FailedMessages(Record.Scope, From);

        Unanswered = failed.Failure;

        if (Unanswered.Length > 0)
        {
            // Asked and not answered: said, and nothing offered — neither the
            // list, which is unknown, nor the evidence's history.
            Shown = [];
            Count = 0;
            Blocked = false;
            Next = null;
            return;
        }

        if (!failed.Listed)
        {
            Fallback();
            return;
        }

        ulong at = From;
        ulong? next = NextOf(failed);

        while (!failed.Messages.Any() && next is { } further && further > at)
        {
            at = further;
            failed = Surface.FailedMessages(Record.Scope, at);
            next = NextOf(failed);
        }

        // A next place that does not move on is the queue's end, not a page.
        Shown = [.. failed.Messages];
        Count = failed.Ports.Aggregate(0ul, (sum, port) => sum + port.Count);
        Blocked = failed.Ports.Any(port => port.Blocked);
        Next = next > at ? next : null;
    }

    // A surface that cannot list failed Messages: the one the Port's evidence
    // names as the last that failed, unless the evidence says none wait now.
    private void Fallback()
    {
        string? named = MessageOperation.FailedIn(Record.Evidence);
        bool waiting = MessageOperation.FailingIn(Record.Evidence) is not 0;

        Shown = named is not null && waiting
            ? [new FailedMessageRecord(string.Empty, string.Empty, named, 0, string.Empty)]
            : [];
        Count = (ulong)Shown.Count;
        Next = null;
    }

    private static ulong? NextOf(FailedMessageList failed)
    {
        return failed.Ports.Select(port => port.Next).FirstOrDefault(next => next is not null);
    }

    private void Page(ulong next)
    {
        From = next;
        Read();
    }

    // An act, through the one gate as the proven caller (ADR-0009, amendment
    // 2026-10-06), which refuses one whose role may not act; recorded in this
    // host's audit with what came of it (ADR-0062) under the action
    // observe::Noun::Message gives it — message.retry or message.dismiss — and
    // said. An Observer is shown no act.
    private async Task Act(string journey, MessageAct act)
    {
        string action = $"{MessageOperation.Noun}.{MessageOperation.Word(act)}";
        string who = Role.Who ?? string.Empty;
        Confirming = null;

        MessageOperation done = new GatedOperator(Surface, Role, Audited)
            .Act(Record.Scope, journey, act, who);
        Audited.Record(
            action,
            done.Applied ? AuditPhase.Execute : AuditPhase.Failure,
            done.Applied ? AuditSeverity.Information : AuditSeverity.Warning,
            done.Result,
            new Dictionary<string, string>
            {
                ["node"] = done.Node,
                ["journey"] = journey,
                ["who"] = who,
            });
        Answer = ActSaid.Answer(done.Applied, done.Result);
        await Acted.InvokeAsync().ConfigureAwait(true);
    }
}
