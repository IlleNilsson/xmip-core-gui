@* Why a scope is Holding, beside the word (ADR-0052 clause 2): the worst leaf
   beneath it, that leaf's evidence, and how old the evidence is. Renders
   nothing when there is no leaf or the worst one is Fine — Fine needs no
   explanation. Linked, the leaf is the way to it: the Monitor's drill at the
   leaf, the one place every view's way to a problem ends (ScopeLink.Monitor),
   so the cause is one click from wherever it is named. Not linked where the
   Why sits inside something that is itself a link or a button. *@
@using Xmip.Gui.Surface

@if (Leaf is not null && Leaf.State != HealthState.Fine)
{
    <span class="why @MoodClass.Of(Leaf.State)">
        @if (Linked)
        {
            <a class="leaf"
               href="@ScopeLink.Monitor(Leaf.Scope, Cluster)">@ScopeTree.Name(Leaf.Scope)</a>
        }
        else
        {
            <span class="leaf">@ScopeTree.Name(Leaf.Scope)</span>
        }
        <span class="mood">@English.Mood(Leaf.State)</span>
        @if (!string.IsNullOrEmpty(Leaf.Evidence))
        {
            <span class="evidence">@Leaf.Evidence</span>
        }
        <span class="age">@English.Age(Leaf.Observed)</span>
    </span>
}

@code {
    /// <summary>The worst leaf beneath the scope, or null when it has none.</summary>
    [Parameter]
    public HealthRecord? Leaf { get; set; }

    /// <summary>Whether the leaf is a link to its place in the drill.</summary>
    [Parameter]
    public bool Linked { get; set; }

    /// <summary>The cluster the link carries, where the host holds more than
    /// one; null where it holds one.</summary>
    [Parameter]
    public string? Cluster { get; set; }
}
