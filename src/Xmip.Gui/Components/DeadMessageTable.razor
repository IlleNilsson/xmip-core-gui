@using System.Globalization
@using Xmip.Abi.Operate
@using Xmip.Gui.Surface

@* The Dead Message Queue view's rows (ADR-0052, amendment 2026-10-01): a
   bounded list of plain rows, as the Subscriptions view's are, and the rest
   counted. The head orders by a column (SortHead), by DeadMessageQuery's
   order, the one every surface uses; the oldest first unless asked. A row's
   Message opens it; its cluster and node are where the drill stands next.
   An entry is not a mood: nothing failed — no Subscription matched it — so
   no row is painted. A role that may operate is offered Replay. *@
<section class="subs-records dead-messages" aria-label="Dead Message Queue">
    @if (Records.Count == 0)
    {
        <p class="empty">No Message here matches.</p>
    }
    else
    {
        <SortHead Columns="Columns" By="@(Query.Sort ?? DeadMessageQuery.Columns[0])"
                  Descending="Query.Descending" Link="Sort" MayAct="MayAct" />
        @foreach (DeadMessageRecord entry in Records.Take(Shown))
        {
            <div class="subs-row" role="row">
                <span></span>
                <span class="subs-since"
                      title="@entry.Received.ToString("u", CultureInfo.InvariantCulture)">
                    @English.Age(entry.Received)
                </span>
                <a class="subs-name dead-message"
                   href="@Link(Query with { Location = entry.Node, Message = entry.Message })">
                    @entry.Message
                </a>
                <a class="subs-cluster"
                   href="@Link(Query with { Location = ClusterOf(entry), Message = null })">
                    @DeadMessageQuery.Cluster(entry)
                </a>
                <a class="subs-node"
                   href="@Link(Query with { Location = entry.Node, Message = null })">
                    @DeadMessageQuery.NodeName(entry)
                </a>
                <span class="subs-destination dead-location" title="@entry.ReceiveLocation">
                    @entry.ReceiveLocation
                </span>
                <span class="subs-figure dead-declines"
                      title="@string.Join("; ", entry.Declines.Select(Said))">
                    @English.Figure((ulong)entry.Declines.Count)
                </span>
                <span class="subs-acts">
                    @if (MayAct)
                    {
                        <DeadMessageReplay Message="entry" Acted="Acted" />
                    }
                </span>
            </div>
        }
        @if (Records.Count > Shown)
        {
            <p class="empty">
                @English.Figure((ulong)(Records.Count - Shown)) more below these @Shown; the
                filter narrows to them.
            </p>
        }
    }
</section>

@code {
    /// <summary>How many rows are drawn.</summary>
    public const int Shown = 200;

    /// <summary>The entries, already selected and ordered.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DeadMessageRecord> Records { get; set; } = [];

    /// <summary>What the view asked for them.</summary>
    [Parameter, EditorRequired]
    public DeadMessageQuery Query { get; set; } = new();

    /// <summary>The cluster a link carries, as every view's links do.</summary>
    [Parameter]
    public Carry? Carried { get; set; }

    /// <summary>Whether the role at the keyboard may act (ADR-0009).</summary>
    [Parameter]
    public bool MayAct { get; set; }

    /// <summary>Raised with a Message and the act taken on it.</summary>
    [Parameter]
    public EventCallback<(DeadMessageRecord, DeadMessageAct)> Acted { get; set; }

    // The columns shown and what each is headed, by DeadMessageQuery's words.
    private static readonly (string Column, string Heading)[] Columns =
    [
        ("received", "received"), ("message", "message"), ("cluster", "cluster"),
        ("node", "node"), ("receive-location", "Receive Location"), ("declines", "declines"),
    ];

    private string Link(DeadMessageQuery query) => ScopeLink.DeadMessages(query, Carried);

    private string Sort(string column, string? order) =>
        Link(Query with { Sort = column, Order = order });

    private static string ClusterOf(DeadMessageRecord entry) =>
        ScopeTree.Join([DeadMessageQuery.Cluster(entry)]);

    private static string Said(KeyValuePair<string, string> decline) =>
        $"{decline.Key}: {decline.Value}";
}
