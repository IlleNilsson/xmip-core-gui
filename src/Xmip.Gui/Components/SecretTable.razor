@using Xmip.Gui.Surface

@* The secrets a node keeps (ADR-0019, amendment 2026-10-29), in the
   subscriptions views' shape: each by its name — what a Location's
   secret = "<name>" says — its kind, when it was last set, where the person
   is (PersonTime; the UTC in its title), and by whom. Never a value: no
   surface reads one back out, so there is none here to show. *@
<section class="subs-records secret-records" aria-label="Secrets">
    @if (Records.Count == 0)
    {
        <p class="empty">No secret is kept here yet.</p>
    }
    else
    {
        <div class="subs-row subs-head" role="row">
            <span>name</span><span>kind</span><span>set</span><span>set by</span>
        </div>
        @foreach (SecretRecord secret in Records)
        {
            <div class="subs-row" role="row">
                <span class="secret-name">@secret.Name</span>
                <span class="secret-kind">@secret.Kind</span>
                <span class="secret-at" title="@PersonTime.Utc(secret.Set)">
                    @PersonTime.Said(secret.Set)
                </span>
                <span class="secret-by">@secret.SetBy</span>
            </div>
        }
    }
</section>

@code {
    /// <summary>The secrets, as the node listed them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SecretRecord> Records { get; set; } = [];
}
