<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desktop operator surface. ADR-0014: one component library, two hosts —
    this MAUI Blazor Hybrid host and the Blazor Web host — rendering the same
    Xmip.Gui screens over the same operator boundary, so the desktop and the
    web cannot disagree.

    Windows only for now: a Windows operator workstation is what
    deployment-model.md targets first. The template's Android, iOS and
    MacCatalyst folders are gone (ADR-0052 clause 6); another platform is a
    target framework and a Platforms folder away when it is wanted.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Xmip.Operations</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Reaches the C ABI through Xmip.Surface's NativeOperator, an adapter
         over Xmip.Abi in xmip-core-abi. Nothing here is unsafe. -->

    <!-- Razor-generated code carries no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ApplicationTitle>Xmip Operations</ApplicationTitle>
    <ApplicationId>se.consid.xmip.operations</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app icon is just the X on white; the wordmark is for the web
         header, not a tiny icon. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The screens. One library, two hosts — ADR-0014. -->
    <ProjectReference Include="..\Xmip.Gui\Xmip.Gui.csproj" />

    <!-- The surface, its choice, runtime discovery and the TOML reader
         (ADR-0052): the same selection as the web host, from the same keys. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.7.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xmip.gui.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
