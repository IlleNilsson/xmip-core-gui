<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desktop operator surface, and the same host on the phone. ADR-0014:
    one component library, two hosts — this MAUI Blazor Hybrid host and the
    Blazor Web host — rendering the same Xmip.Gui screens over the same
    operator boundary, so the desktop and the web cannot disagree.

    Windows, Android and iOS (ADR-0014, amendment 2026-10-14: the phone is
    this host on more targets, not a fifth surface). Only Windows is built
    for now (the owner, 2026-11-02: *Just build Windows, we can get back to
    other OS and target*): the Android and iOS targets are written and not
    attempted, iOS only ever on macOS, where Apple's tools run. On a phone the host follows nodes
    remotely over their operate listener and only observes: what configures
    a cluster (the Configure page, its editing components and
    MauiProgram.Desktop.cs) is compiled for Windows alone, and
    MauiProgram.Phone.cs for the two phones. macOS and Linux are not targets
    of this file today (ADR-0014, amendment 2026-10-13).
  -->

  <PropertyGroup>
    <!-- Directory.Build.props names one framework for the repository; this
         project names its own, per platform, so the one is cleared. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net11.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Xmip.Operations</RootNamespace>
    <!-- The System Process is xmip-operations (ADR-0053). -->
    <AssemblyName>xmip-operations</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Reaches the runtime through Xmip.Surface, an adapter over Xmip.Abi in
         xmip-core-abi. Nothing here is unsafe. -->

    <!-- Razor-generated code carries no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ApplicationTitle>Xmip Operations</ApplicationTitle>
    <ApplicationId>se.consid.xmip.operations</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Which platform this build is for, said once and read below. -->
  <PropertyGroup>
    <XmipPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</XmipPlatform>
    <XmipPhone Condition="'$(XmipPlatform)' == 'android' Or '$(XmipPlatform)' == 'ios'">true</XmipPhone>
  </PropertyGroup>

  <!-- The oldest each platform runs: the MAUI template's floors for .NET 11. -->
  <PropertyGroup Condition="'$(XmipPlatform)' == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XmipPlatform)' == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XmipPlatform)' == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Every page and keeper speaks to the runtime through Xmip.Surface; the
       test links the platform keepers and says the same, so one global using
       serves both and neither warns about the other's. -->
  <ItemGroup>
    <Using Include="Xmip.Surface" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app icon is just the X on white; the wordmark is for the web
         header, not a tiny icon. The splash is the same X on the same white:
         the template's purple .NET wordmark went (ADR-0052 clause 6). -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The screens. One library, two hosts — ADR-0014. -->
    <ProjectReference Include="..\Xmip.Gui\Xmip.Gui.csproj" />

    <!-- The surface, its choice, runtime discovery and the TOML reader
         (ADR-0052): the same selection as the web host, from the same keys. -->
    <ProjectReference Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

  <!-- What each build leaves out, by the SDK's own default globs. The phone
       observes and nothing else: no Configure or Authority page, no editing components,
       no desktop start-up and no desktop document; its own is shipped inside
       the app (Resources/Raw/gui.toml). The desktop leaves out the
       phone's start-up and document. -->
  <PropertyGroup Condition="'$(XmipPhone)' == 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);MauiProgram.Desktop.cs;Components\Pages\Configure.razor;Components\Pages\Authority.razor;Components\Editing\**;gui.toml</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XmipPhone)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);MauiProgram.Phone.cs;Resources\Raw\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(XmipPhone)' != 'true'">
    <None Update="gui.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- XmipPhoneDocument, where a build names one, is the phone's document
       in place of Resources/Raw/gui.toml: Build-XmipService -Remote
       Android -Package apk -Address writes it with the node to follow
       (ADR-0014, amendment 2026-10-22), so no one edits the shipped one. -->
  <ItemGroup Condition="'$(XmipPhone)' == 'true'">
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Remove="Resources\Raw\gui.toml" Condition="'$(XmipPhoneDocument)' != ''" />
    <MauiAsset Include="$(XmipPhoneDocument)" LogicalName="gui.toml" Condition="'$(XmipPhoneDocument)' != ''" />
  </ItemGroup>

  <!-- The runtime's native library for each platform, from xmip-core-abi,
       where it is said once. -->
  <Import Project="..\..\..\..\..\foundation\abi\dotnet\build\Xmip.Abi.Native.props" />

</Project>
