@page "/configure"
@using Xmip.Operations.Configuration
@inject RuntimeCommands Runtime
@inject RoleContext Role
@inject NavigationManager Nav

<PageTitle>Xmip — Configure</PageTitle>

@* The cluster's xmip.toml, the one file anyone edits (ADR-0031, amendment
   2026-10-05): an overview of the cluster, drilling down to a node and to
   its artifacts by kind, then to an entry whose values are edited in place.
   Every view, edit and refusal is the runtime's (xmip_operate.h section
   10); the page draws what it answers and sends the edits. *@
<section class="cfg-layout">
    <aside class="configs">
        <h2>Cluster</h2>
        <button class="config-item @Sel(Overview)" @onclick="() => Show(Overview)">
            <span class="config-name">@Say(_cluster?.Name, "Overview")</span>
        </button>

        <h2>Nodes</h2>
        @foreach (string node in _cluster?.Nodes ?? [])
        {
            string name = node;
            <button class="config-item @Sel(NodeKey(name))" @onclick="() => Show(NodeKey(name))">
                <span class="config-name">@name</span>
                @if (name == Runtime.Delivery.Node)
                {
                    <span class="badge" title="the Node xmip.gui.toml names">started here</span>
                }
            </button>
        }

        <h2>Artifacts</h2>
        @foreach (ArtifactView view in Artifacts())
        {
            ArtifactView kind = view;
            <button class="config-item @Sel(KindKey(kind.Kind)) @(kind.Defined ? "" : "undefined")"
                    @onclick="() => Show(KindKey(kind.Kind))">
                <span class="config-name">@kind.Title</span>
                @if (kind.Defined)
                {
                    <span class="count">@kind.Entries.Count</span>
                }
            </button>
        }
        <p class="dir">@Runtime.Delivery.ClusterPath</p>
    </aside>

    <div class="cfg">
        <div class="path">
            <button class="primary" disabled="@(_cluster is not { Editable: true })"
                    @onclick="Save">Save</button>
            <button disabled="@(_cluster is null)" @onclick="Validate">Validate</button>
            @if (Runtime.Delivery.Node is { } started)
            {
                <button @onclick="StartNode">Start @started</button>
            }
            @if (_cluster is { Changed: true })
            {
                <span class="changed">changed, not saved</span>
            }
            <span class="status @(_ok ? "ok" : "bad")">@_status</span>
        </div>

        @if (_deliveries.Count > 0)
        {
            <div class="group">
                <h2>Each node's slice</h2>
                <table class="locs deliveries">
                    <thead><tr><th>Node</th><th>Outcome</th><th></th></tr></thead>
                    <tbody>
                        @foreach (NodeDelivery delivered in _deliveries)
                        {
                            <tr class="@delivered.Outcome.ToString().ToLowerInvariant()">
                                <td>@delivered.Node</td>
                                <td>@delivered.Word</td>
                                <td>@delivered.Said</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_cluster is null)
        {
        }
        else if (!_cluster.Editable)
        {
            <div class="group">
                <h2>Not a cluster's xmip.toml</h2>
                <p class="empty">@_cluster.Refusal</p>
            </div>
        }
        else if (CurrentEntry() is { } entry)
        {
            <EntryEditor Entry="entry" Kind="EntryKind(entry)" Edit="Edit" />
        }
        else if (_selection == Overview)
        {
            @foreach (ArtifactEntry shared in _cluster.Views.Of("cluster")?.Entries ?? [])
            {
                <EntryEditor Entry="shared" Kind="Shared" Edit="Edit" />
            }
            <div class="group">
                <div class="group-head">
                    <h2>Nodes</h2>
                    <input placeholder="node name" @bind="_newNode" />
                    <button @onclick="AddNode">+ add node</button>
                </div>
                <EntryList Entries="NodeEntries()" Open="Open" Edit="Edit" />
            </div>
        }
        else if (_selection.StartsWith(NodePrefix, StringComparison.Ordinal))
        {
            string node = _selection[NodePrefix.Length..];
            @if (NodeEntries().FirstOrDefault(own => own.Name == node) is { } own)
            {
                <EntryEditor Entry="own" Kind="NodeTitle" Edit="Edit" />
            }
            @foreach (ArtifactView view in Artifacts().Where(view => view.Defined))
            {
                <div class="group">
                    <div class="group-head">
                        <h2>@view.Title</h2>
                        <AddEntry Places="Places(view, node)" Edit="Edit" />
                    </div>
                    <EntryList Entries="Within(view, node)" Open="Open" Edit="Edit" />
                </div>
            }
        }
        else if (_cluster.Views.Of(_selection[KindPrefix.Length..]) is { } view)
        {
            <div class="group">
                <div class="group-head">
                    <h2>@view.Title</h2>
                    @if (view.Defined)
                    {
                        <AddEntry Places="view.Places" Edit="Edit" />
                    }
                </div>
                @if (view.Note is { } note)
                {
                    <p class="empty">@note</p>
                }
                @if (view.Defined)
                {
                    <EntryList Entries="view.Entries" Open="Open" Edit="Edit" />
                }
            </div>
        }
    </div>
</section>

@code {
    private const string Overview = "overview";
    private const string NodePrefix = "node:";
    private const string KindPrefix = "kind:";
    private const string Shared = "Shared by the cluster";
    private const string NodeTitle = "The node's own";

    private ClusterConfiguration? _cluster;
    private string _selection = Overview;
    private IReadOnlyList<string>? _entry;
    private IReadOnlyList<NodeDelivery> _deliveries = [];
    private string _newNode = "";
    private string _status = "";
    private bool _ok = true;

    protected override void OnInitialized()
    {
        // Configuration is the Operator's, not the Observer's (ADR-0009). An
        // Observer who reaches this URL directly is sent back to Monitor — the
        // role is assigned, so this is a guard, not a choice to reconsider.
        if (!Role.MayConfigure())
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            _cluster = ClusterConfiguration.Open(Runtime.Delivery.ClusterPath);
            _status = _cluster.Exists
                ? $"editing {Path.GetFileName(_cluster.Path)}"
                : $"no file at {_cluster.Path} yet: add a node, then save";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _status = exception.Message;
            _ok = false;
        }
    }

    // The kinds below the cluster and its nodes, as the runtime lists them.
    private IEnumerable<ArtifactView> Artifacts()
    {
        return _cluster?.Views.Views.Where(view => view.Kind is not ("cluster" or "node")) ?? [];
    }

    private IReadOnlyList<ArtifactEntry> NodeEntries()
    {
        return _cluster?.Views.Of("node")?.Entries ?? [];
    }

    // A node's own entries of a kind: those whose table is beneath the node's.
    private static IReadOnlyList<ArtifactEntry> Within(ArtifactView view, string node)
    {
        return (ArtifactEntry[])[.. view.Entries.Where(entry => Beneath(entry.Section, node))];
    }

    private static IReadOnlyList<ArtifactPlace> Places(ArtifactView view, string node)
    {
        return (ArtifactPlace[])[.. view.Places.Where(place => Beneath(place.Section, node))];
    }

    private static bool Beneath(IReadOnlyList<string> section, string node)
    {
        return section.Count > 2 && section[0] == "nodes" && section[1] == node;
    }

    private static string NodeKey(string node) => NodePrefix + node;

    private static string KindKey(string kind) => KindPrefix + kind;

    private string Sel(string key) => _entry is null && _selection == key ? "selected" : "";

    private static string Say(string? text, string unset) =>
        string.IsNullOrEmpty(text) ? unset : text;

    private void Show(string selection)
    {
        _selection = selection;
        _entry = null;
    }

    private void Open(ArtifactEntry entry)
    {
        _entry = entry.Section;
    }

    // The entry open now, found again by its section after every edit; one
    // that is gone — renamed or removed — returns the page to its list.
    private ArtifactEntry? CurrentEntry()
    {
        return _entry is null
            ? null
            : _cluster?.Views.Views
                .SelectMany(view => view.Entries)
                .FirstOrDefault(entry => entry.Section.SequenceEqual(_entry));
    }

    private string EntryKind(ArtifactEntry entry)
    {
        ArtifactView? view =
            _cluster?.Views.Views.FirstOrDefault(view => view.Entries.Contains(entry));
        return $"{view?.Title} {entry.Name}, {entry.Scope}";
    }

    // Every edit through the runtime: made, or refused in its words and
    // audited (ADR-0062).
    private bool Edit(ClusterEdit edit)
    {
        if (_cluster is null)
        {
            return false;
        }

        if (_cluster.TryEdit(edit, out string refusal))
        {
            _status = "edited; not saved";
            _ok = true;
            return true;
        }

        Runtime.Refused(edit, _cluster.Path, refusal);
        _status = refusal;
        _ok = false;
        return false;
    }

    private void AddNode()
    {
        if (Edit(new ClusterEdit.AddNode(_newNode.Trim())))
        {
            _newNode = "";
        }
    }

    // Saved as it stands, then judged by the runtime, then sliced for each
    // node and each slice shipped where it can go (ADR-0031, amendment
    // 2026-10-05): what the operator reads is the runtime's verdict on what
    // is on disk and every node's outcome.
    private void Save()
    {
        if (_cluster is null)
        {
            return;
        }

        ClusterSave saved = Runtime.Save(_cluster);
        _deliveries = saved.Nodes;
        _status = saved.Said;
        _ok = saved.Valid && saved.Nodes.All(node => node.Outcome != NodeDelivery.Standing.Refused);
    }

    // The verdict is decided from the record and the sentence is shown
    // (ADR-0052 clause 4). What is validated is the text the editor holds,
    // saved or not (ADR-0027, amendment 2026-09-05).
    private void Validate()
    {
        if (_cluster is not null)
        {
            Show(Runtime.Validate(_cluster.Path, _cluster.Text));
        }
    }

    private void StartNode()
    {
        Show(Runtime.StartNode());
    }

    private void Show(ConfigurationVerdict verdict)
    {
        _status = verdict.Said;
        _ok = verdict.Ok;
    }
}
