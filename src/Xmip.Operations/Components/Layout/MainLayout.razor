@inherits LayoutComponentBase
@inject RoleContext Role

@* The desktop does both, so beside the shared bar's views it offers
   configuring (ADR-0014). What it offers follows the role (ADR-0009), which is
   assigned, not chosen here: an Observer watches and is not shown Configure
   at all. A real identity will gate this (ADR-0022/ADR-0027); until then the
   role is assigned at launch. *@
<TopNav>
    @if (Role.MayConfigure())
    {
        <NavLink class="topnav-link" href="/configure">Configure</NavLink>
    }
</TopNav>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
