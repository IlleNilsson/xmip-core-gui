<ContentPage xmlns:local="clr-namespace:Xmip.Operations"
             xmlns:components="clr-namespace:Xmip.Operations.Components"
             x:Class="Xmip.Operations.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
