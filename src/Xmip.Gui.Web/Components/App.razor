@using Microsoft.AspNetCore.Http
@using Xmip.Surface.Relay

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="@Assets["_content/Xmip.Gui/xmip-x.png"]" />
    <BasePath />
    <ResourcePreloader />
    @* One stylesheet, the shared library's; this host has no scoped CSS of
       its own, the template's went (ADR-0052 clause 6). *@
    <link rel="stylesheet" href="@Assets["_content/Xmip.Gui/xmip.css"]" />
    @* The one inline script, carrying this response's nonce: the content
       security policy runs no other (ContentSecurity, Xmip.Surface.Relay). *@
    <ImportMap nonce="@ContentSecurity.Nonce(HttpContext)" />
    <HeadOutlet />
</head>

<body>
    @* Interactive on the server: this host's decision, not the shared pages'.
       A MAUI host renders the same pages with no render mode at all. *@
    @* The order the browser keeps the bar in, from its cookie, handed to
       the circuit so the bar is drawn in it from the first paint. *@
    <Routes @rendermode="InteractiveServer"
            BarSaid="@HttpContext.Request.Cookies[Xmip.Gui.Surface.BarOrder.Cookie]" />
    @* The estate's own reconnect element, styled by xmip.css; without it
       blazor.web.js draws a box of its own (the owner, 2026-09-14). *@
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // The request this page renders for: its nonce is the policy's.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
