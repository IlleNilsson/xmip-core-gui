@page "/Error"
@using System.Diagnostics

@* Where the host sends a request that failed outside Development
   (Program.cs). The page says that it failed and how to find it in the log;
   the log says why. The template's page, with its lecture on the Development
   environment, went (ADR-0052 clause 6). *@
<PageTitle>Xmip — Error</PageTitle>

<section class="trouble">
    <h1>This request failed.</h1>
    <p>The board is unaffected; the host's log has the reason.</p>
    @if (ShowRequestId)
    {
        <p>Request <code>@RequestId</code>.</p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
