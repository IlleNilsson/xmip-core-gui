@inherits LayoutComponentBase
@using Xmip.Gui.Surface
@inject RoleContext Role

@* The web GUI monitors and does nothing else (ADR-0014, amendment of
   2026-09-05; ADR-0052 clause 3): its role is Observer and that is not
   configurable, so the badge says so and never changes. *@
<nav class="topnav">
    <NavLink class="topnav-link" href="/" Match="NavLinkMatch.All">Monitor</NavLink>
    <NavLink class="topnav-link" href="/topology">Topology</NavLink>
    <div class="role">
        <span class="role-label">role</span>
        <span class="role-pick active" title="@Describe(Role.Role)">@Role.Role.Label()</span>
    </div>
</nav>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string Describe(Xmip.Gui.Surface.Role role)
    {
        return role switch
        {
            Xmip.Gui.Surface.Role.Observer => "watches",
            Xmip.Gui.Surface.Role.Operator => "also configures",
            Xmip.Gui.Surface.Role.Developer => "also builds",
            _ => "",
        };
    }
}
