<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Target framework, nullability, analysis level and warnings-as-errors come
    from Directory.Build.props at the repository root, the same as every .NET
    repository in the estate. Only what is specific to this project is here.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Gui.Web</RootNamespace>
    <AssemblyName>Xmip.Gui.Web</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- The web host reaches xmip_operate.h through Xmip.Surface's
         NativeOperator, an adapter over Xmip.Abi in xmip-core-abi — the one
         place the function pointers and raw structs live. Nothing here is
         unsafe. -->

    <!-- Razor-generated code does not carry XML documentation and the template
         turns CS1591 into an error for everything. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The screens. One library, two hosts — ADR-0014. -->
    <ProjectReference Include="..\Xmip.Gui\Xmip.Gui.csproj" />

    <!-- The surface, its choice and the TOML reader (ADR-0052). Xmip
         configures nothing in JSON, so the template's appsettings files are
         gone and xmip.gui.toml is read through Xmip.Surface instead. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xmip.gui.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
