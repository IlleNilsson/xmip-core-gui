<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org only, and no package younger than architecture.toml's
     [project] nugetMinimumAgeHours (ADR-0021, amendment 2026-11-07). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="24" />
  </packageSources>
</configuration>
